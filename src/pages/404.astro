---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import { ui } from '../content/site';

const localizedCopy = { uk: ui.uk.notFoundContent, en: ui.en.notFoundContent };
const initialCopy = localizedCopy.uk;
---

<BaseLayout locale="uk" title="404 — lytvynenko.designer" description={initialCopy.message}>
  <div class="not-found-page" data-not-found data-locale="uk">
    <header class="site-header not-found-header">
      <a class="site-header__home not-found-header__home" data-home-link href="/" aria-label={initialCopy.homeAria}>lytvynenko.designer</a>
      <div class="not-found-language" role="group" aria-label={initialCopy.languageAria}>
        <button type="button" class="not-found-language__button is-active" data-locale-button="uk" aria-current="true">UA</button>
        <button type="button" class="not-found-language__button" data-locale-button="en">EN</button>
      </div>
    </header>

    <main class="not-found-main">
      <section class="not-found-content" aria-labelledby="not-found-title">
        <div class="not-found-primary">
          <div class="not-found-game" data-game-shell>
            <canvas class="not-found-game__canvas" data-game-canvas width="1200" height="500" role="img" aria-label="404"></canvas>
            <div class="not-found-game__overlay" data-game-overlay>
              <h1 id="not-found-title" class="not-found-game__title" data-game-title data-copy-key="title">{initialCopy.title}</h1>
              <p class="not-found-game__result" data-game-result hidden></p>
              <p class="not-found-content__message" data-game-message>
                <span data-copy-key="messageFirst">{initialCopy.messageFirst}</span>
                <span data-copy-key="messageSecond">{initialCopy.messageSecond}</span>
              </p>
              <div class="not-found-actions">
                <Button label={initialCopy.start} type="button" variant="primary" size="large" dataAction="start" />
                <Button label={initialCopy.home} href="/" variant="outline" size="large" dataAction="home" />
              </div>
            </div>
            <div class="not-found-game__hud" data-game-hud hidden>
              <span data-game-score></span>
              <span data-game-state aria-live="polite"></span>
            </div>
          </div>
        </div>

        <div class="not-found-rules" data-game-rules>
          <p class="not-found-rules__title" data-copy-key="rulesTitle">{initialCopy.rulesTitle}</p>
          <div class="not-found-rules__items">
            <span class="not-found-rules__item">
              <span class="not-found-key">←</span>
              <span class="not-found-key">→</span>
              <span>—</span>
              <span data-copy-key="move">{initialCopy.move}</span>
            </span>
            <span class="not-found-rules__item">
              <span class="not-found-key not-found-key--space">Space</span>
              <span>—</span>
              <span data-copy-key="shoot">{initialCopy.shoot}</span>
            </span>
          </div>
        </div>

        <div class="not-found-touch-controls" data-touch-controls hidden>
          <button type="button" data-control="left" aria-label={initialCopy.touchLeft}>←</button>
          <button type="button" data-control="shoot" aria-label={initialCopy.touchShoot}>●</button>
          <button type="button" data-control="right" aria-label={initialCopy.touchRight}>→</button>
        </div>
        <div class="not-found-orientation-prompt" data-orientation-prompt role="status" aria-live="polite" hidden>
          <span data-copy-key="orientationHint">{initialCopy.orientationHint}</span>
        </div>
      </section>
    </main>
  </div>
</BaseLayout>

<style>
  .not-found-page { min-height: 100vh; background: #fff; }
  .not-found-header { position: fixed; }
  .not-found-header__home { z-index: 1; }
  .not-found-language { display: inline-flex; grid-column: 2; grid-row: 1; align-items: center; padding: 2px; border: 1px solid var(--color-border-default); border-radius: var(--radius-full); background: var(--color-surface-elevated); }
  .not-found-language__button { min-width: 2.75rem; min-height: 2rem; padding: var(--space-1) var(--space-2); border: 0; border-radius: var(--radius-full); background: transparent; color: var(--color-text-secondary); cursor: pointer; font-size: var(--font-caption-size); line-height: var(--font-caption-line); }
  .not-found-language__button:hover { color: var(--color-text-primary); }
  .not-found-language__button.is-active { background: var(--color-accent-primary); color: var(--color-text-inverse); }
  .not-found-language__button:focus-visible { outline: 2px solid var(--color-status-info); outline-offset: 2px; }
  .not-found-main { display: flex; min-height: 100vh; padding: calc(7.875rem + var(--space-16)) var(--page-gutter) var(--space-16); justify-content: center; }
  .not-found-content { display: flex; width: min(100%, 75rem); flex-direction: column; align-items: center; gap: var(--space-10); text-align: center; }
  .not-found-content { margin-block: auto; }
  .not-found-primary { width: 100%; min-width: 100%; align-self: stretch; }
  .not-found-game { position: relative; width: 100%; max-width: none; }
  .not-found-game__canvas { display: block; width: 100%; height: auto; image-rendering: pixelated; }
  .not-found-game__overlay { position: absolute; inset: 0; display: grid; align-content: center; justify-items: center; gap: var(--space-5); padding: var(--space-8); background: rgba(255, 255, 255, .95); text-align: center; }
  .not-found-game__overlay[hidden] { display: none; }
  .not-found-game__title { max-width: 43rem; margin: 0; color: var(--color-text-primary); font-size: clamp(1.5rem, 3vw, 2.75rem); line-height: 1.1; }
  .not-found-game__result { margin: calc(var(--space-2) * -1) 0 0; color: var(--color-text-secondary); font-size: var(--font-caption-size); line-height: var(--font-caption-line); }
  .not-found-game__hud { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  .not-found-content__message { display: grid; max-width: 43rem; gap: var(--space-1); margin: 0; color: var(--color-text-primary); font-size: var(--font-body-size); line-height: var(--font-body-line); text-align: center; }
  .not-found-content__message[hidden], .not-found-rules[hidden] { display: none; }
  .not-found-content__message span { display: block; }
  .not-found-actions { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: var(--space-3); }
  .not-found-actions .button { touch-action: manipulation; }
  :global(.not-found-game__overlay [data-404-action="home"]) { border-color: var(--color-border-default); background: #fff; }
  :global(.not-found-game__overlay [data-404-action="home"]:hover) { border-color: transparent; background: var(--color-accent-hover); color: var(--color-text-inverse); }
  .not-found-rules { display: grid; gap: var(--space-2); min-width: min(100%, 22rem); justify-items: center; color: var(--color-text-secondary); text-align: center; }
  .not-found-rules__title { margin: 0; color: var(--color-text-primary); font-size: var(--font-caption-semibold-size); font-weight: var(--font-caption-semibold-weight); line-height: var(--font-caption-semibold-line); }
  .not-found-rules__items { display: flex; align-items: center; justify-content: center; gap: var(--space-4); font-size: var(--font-caption-size); line-height: var(--font-caption-line); }
  .not-found-rules__item { display: inline-flex; align-items: center; gap: var(--space-1); }
  .not-found-key { display: inline-grid; min-width: 1.75rem; min-height: 1.75rem; padding: var(--space-1); place-items: center; border: 1px solid var(--color-border-subtle); border-radius: var(--radius-s); background: var(--color-surface-tertiary); color: var(--color-text-primary); font-size: var(--font-caption-size); line-height: 1; box-shadow: inset 0 -1px 0 rgba(32, 38, 59, .12); }
  .not-found-key--space { min-width: 3.75rem; }
  .not-found-touch-controls { display: flex; justify-content: center; gap: var(--space-3); }
  .not-found-touch-controls[hidden], .not-found-game__hud[hidden] { display: none; }
  .not-found-touch-controls button { display: grid; width: 3.5rem; height: 3rem; place-items: center; border: 1px solid var(--color-border-default); border-radius: var(--radius-m); background: var(--color-surface-elevated); color: var(--color-text-primary); cursor: pointer; font-size: 1.25rem; touch-action: none; user-select: none; }
  .not-found-touch-controls button[data-control="shoot"] { color: var(--color-status-error); }
  .not-found-touch-controls button:active { background: var(--color-surface-tertiary); transform: scale(.96); }
  .not-found-orientation-prompt { position: fixed; z-index: 40; inset: 0; display: grid; align-content: center; justify-items: center; gap: var(--space-5); padding: var(--page-gutter); background: rgba(255, 255, 255, .94); color: var(--color-text-primary); font-size: var(--font-body-size); line-height: var(--font-body-line); text-align: center; }
  .not-found-orientation-prompt[hidden] { display: none; }
  .not-found-page.is-game-started .not-found-game__canvas { touch-action: none; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }

  @media (max-width: 640px) {
    .not-found-main { flex-direction: column; align-items: center; padding-top: calc(4.5rem + var(--space-8)); padding-bottom: var(--space-10); }
    .not-found-content { width: 100%; min-height: 0; margin: 0; flex: 1; justify-content: center; gap: 0; }
    .not-found-primary { display: flex; min-height: 0; flex: 0 0 auto; align-items: center; justify-content: center; }
    .not-found-page:not(.is-game-started) .not-found-game { display: grid; }
    .not-found-page:not(.is-game-started) .not-found-game__canvas { position: absolute; inset: 0; width: 100%; height: 100%; aspect-ratio: auto; }
    .not-found-page:not(.is-game-started) .not-found-game__overlay { position: relative; min-height: 0; }
    .not-found-game__overlay { padding: var(--space-4); }
    .not-found-content__message { max-width: 22rem; }
    .not-found-game__canvas { aspect-ratio: 2 / 1; }
    .not-found-actions { width: auto; flex-direction: column; align-items: center; }
    .not-found-actions .button { width: auto; }
    .not-found-rules { width: 100%; margin-top: var(--space-2); }
    .not-found-rules__items { flex-direction: column; gap: var(--space-2); }
  }

  .not-found-page.is-touch-device.is-game-started { position: fixed; z-index: 10; inset: 0; min-height: 100vh; min-height: 100dvh; overflow: hidden; }
  .not-found-page.is-touch-device.is-game-started .not-found-header { display: none; }
  .not-found-page.is-touch-device.is-game-started .not-found-main { height: 100vh; height: 100dvh; min-height: 100vh; min-height: 100dvh; padding: 0 var(--page-gutter); overflow: hidden; }
  .not-found-page.is-touch-device.is-game-started .not-found-content { width: 100%; height: 100%; margin: 0; gap: 0; justify-content: center; }
  .not-found-page.is-touch-device.is-game-started .not-found-primary { width: 100%; height: 100%; flex: 1; align-items: center; justify-content: center; }
  .not-found-page.is-touch-device.is-game-started .not-found-game { width: 100%; max-width: none; }
  .not-found-page.is-touch-device.is-game-started .not-found-rules,
  .not-found-page.is-touch-device.is-game-started .not-found-touch-controls { display: none; }

  @media (orientation: landscape) {
    .not-found-page.is-touch-device.is-game-started .not-found-game { aspect-ratio: 2 / 1; }
  }

  @media (orientation: portrait) {
    .not-found-page.is-touch-device.is-game-sideways .not-found-game { height: 100%; aspect-ratio: auto; }
    .not-found-page.is-touch-device.is-game-sideways .not-found-game__canvas { position: absolute; top: 50%; left: 50%; width: calc(100dvh - 2 * var(--page-gutter)); max-width: none; transform: translate(-50%, -50%) rotate(90deg); transform-origin: center; }
  }

  @media (prefers-reduced-motion: reduce) {
    .not-found-touch-controls button { transition: none; }
  }
</style>

<script define:vars={{ localizedCopy }}>
  const page = document.querySelector('[data-not-found]');
  const canvas = document.querySelector('[data-game-canvas]');
  const gameShell = document.querySelector('[data-game-shell]');
  const gameOverlay = document.querySelector('[data-game-overlay]');
  const gameTitle = document.querySelector('[data-game-title]');
  const gameResult = document.querySelector('[data-game-result]');
  const gameMessage = document.querySelector('[data-game-message]');
  const gameRules = document.querySelector('[data-game-rules]');
  const startButton = document.querySelector('[data-404-action="start"]');
  const homeButton = document.querySelector('[data-404-action="home"]');
  const homeLink = document.querySelector('[data-home-link]');
  const gameHud = document.querySelector('[data-game-hud]');
  const scoreElement = document.querySelector('[data-game-score]');
  const stateElement = document.querySelector('[data-game-state]');
  const touchControls = document.querySelector('[data-touch-controls]');
  const orientationPrompt = document.querySelector('[data-orientation-prompt]');
  const context = canvas?.getContext('2d');

  if (page && canvas && context && startButton && homeButton && homeLink && gameShell && gameOverlay && gameTitle && gameResult && gameMessage && gameRules && gameHud && scoreElement && stateElement && touchControls && orientationPrompt) {
    const copy = localizedCopy;
    const localeButtons = [...document.querySelectorAll('[data-locale-button]')];
    const copyElements = [...document.querySelectorAll('[data-copy-key]')];
    const preferredLocale = localStorage.getItem('lytvynenko-locale');
    const pathLocale = window.location.pathname.startsWith('/en/') ? 'en' : undefined;
    let locale = pathLocale ?? (preferredLocale === 'en' ? 'en' : 'uk');

    const blocks = [
      [3, 4, 8, 9, 10, 15, 16],
      [2, 4, 7, 11, 14, 16],
      [1, 4, 7, 11, 13, 16],
      [1, 2, 3, 4, 5, 7, 11, 13, 14, 15, 16, 17],
      [4, 7, 11, 16],
      [4, 8, 9, 10, 16],
    ];
    const invaderPattern = [
      '0001100000',
      '0011110000',
      '0111111000',
      '1101101100',
      '1111111110',
      '0010010000',
      '0101101000',
      '1000000100',
      '0001100000',
      '0010010000',
    ];
    const game = {
      started: false,
      running: false,
      lost: false,
      won: false,
      score: 0,
      level: 0,
      direction: 1,
      moveTimer: 0,
      lastFrame: 0,
      lastShot: 0,
      frame: 0,
      gameSize: { width: 600, height: 300 },
      invaderMultiplier: 1,
      invaderSize: 20,
      invaderSpeed: 20,
      invaderAttackRate: 0.999,
      invaders: [],
      bullets: [],
      playerX: 0,
      playerY: 0,
      controls: new Set(),
      touchGesture: { active: false, pointerId: null, startX: 0, lastX: 0, moved: false },
      startPending: false,
    };
    let startDelayTimer;

    const setGameSize = () => {
      if (window.innerWidth > 1200) {
        game.gameSize = { width: 1200, height: 500 };
        game.invaderMultiplier = 3;
      } else if (window.innerWidth > 800) {
        game.gameSize = { width: 900, height: 600 };
        game.invaderMultiplier = 2;
      } else {
        game.gameSize = { width: 600, height: 300 };
        game.invaderMultiplier = 1;
      }
      canvas.width = game.gameSize.width;
      canvas.height = game.gameSize.height;
      game.playerX = game.gameSize.width / 2 - 8;
      game.playerY = game.gameSize.height - 16;
    };

    const getPixelRow = (rowRaw) => {
      const row = Math.floor(rowRaw / game.invaderMultiplier);
      if (row >= blocks.length) return [];
      const textRow = [];
      let placer = 0;
      blocks[row].forEach((block) => {
        const start = block * game.invaderMultiplier;
        for (let index = 0; index < game.invaderMultiplier; index += 1) {
          textRow[placer + index] = start + index;
        }
        placer += game.invaderMultiplier;
      });
      return textRow;
    };

    const createInvaders = () => {
      const invaders = [];
      let row = blocks.length * game.invaderMultiplier;
      while (row--) {
        getPixelRow(row).forEach((column) => {
          invaders.push({
            x: column * game.invaderSize,
            y: row * game.invaderSize,
            width: game.invaderSize,
            height: game.invaderSize,
            active: true,
            patrolX: 0,
            speedX: game.invaderSpeed,
          });
        });
      }
      const minX = Math.min(...invaders.map((invader) => invader.x));
      const maxX = Math.max(...invaders.map((invader) => invader.x + invader.width));
      const offsetX = (game.gameSize.width - (maxX - minX)) / 2 - minX;
      invaders.forEach((invader) => { invader.x += offsetX; });
      return invaders;
    };

    const drawInvader = (invader) => {
      const pixelSize = game.invaderSize / invaderPattern[0].length;
      context.fillStyle = '#050505';
      invaderPattern.forEach((row, rowIndex) => [...row].forEach((cell, columnIndex) => {
        if (cell === '1') context.fillRect(invader.x + columnIndex * pixelSize, invader.y + rowIndex * pixelSize, pixelSize, pixelSize);
      }));
    };

    const drawPlayer = () => {
      context.fillStyle = '#050505';
      context.fillRect(game.playerX, game.playerY, 16, 8);
      context.fillRect(game.playerX - 2, game.playerY + 2, 20, 6);
      context.fillRect(game.playerX + 6, game.playerY - 4, 4, 4);
    };

    const drawBullet = (bullet) => {
      context.fillStyle = '#050505';
      context.fillRect(bullet.x, bullet.y, 3, 3);
    };

    const drawPoints = () => {
      context.fillStyle = '#050505';
      context.font = '10px "Lucida Console", monospace';
      context.textAlign = 'right';
      context.fillText(`${copy[locale].score}: ${game.score}`, game.gameSize.width, game.gameSize.height - 12);
    };

    const drawStatic404 = () => {
      context.clearRect(0, 0, canvas.width, canvas.height);
      context.fillStyle = '#fff';
      context.fillRect(0, 0, canvas.width, canvas.height);
      const minX = Math.min(...game.invaders.map((invader) => invader.x));
      const maxX = Math.max(...game.invaders.map((invader) => invader.x + invader.width));
      const staticScale = Math.min(2.2, (game.gameSize.width * .99) / (maxX - minX));
      context.save();
      context.translate(game.gameSize.width / 2, 0);
      context.scale(staticScale, staticScale);
      context.translate(-game.gameSize.width / 2, 0);
      game.invaders.forEach(drawInvader);
      context.restore();
      drawPlayer();
      drawPoints();
    };

    const updateScore = () => {
      const activeCopy = copy[locale];
      scoreElement.textContent = `${activeCopy.score}: ${game.score}`;
      stateElement.textContent = game.lost ? activeCopy.lost : game.won ? activeCopy.won : '';
    };

    const isTouchDevice = () => window.matchMedia('(pointer: coarse)').matches || 'ontouchstart' in window;
    const isTouchPortrait = () => isTouchDevice() && window.matchMedia('(orientation: portrait)').matches;

    const updateGameOrientation = () => {
      page.classList.toggle('is-touch-device', isTouchDevice());
      page.classList.toggle('is-game-started', game.started);
      page.classList.toggle('is-game-sideways', game.started && isTouchDevice() && window.matchMedia('(orientation: portrait)').matches);
    };

    const hideOrientationPrompt = () => {
      window.clearTimeout(startDelayTimer);
      game.startPending = false;
      orientationPrompt.hidden = true;
    };

    const startGame = () => {
      hideOrientationPrompt();
      resetGame();
      drawGame();
      game.frame = window.requestAnimationFrame(loop);
    };

    const showOrientationPrompt = () => {
      if (game.startPending) return;
      game.startPending = true;
      orientationPrompt.hidden = false;
      startDelayTimer = window.setTimeout(startGame, 2000);
    };

    const showFinishedOverlay = () => {
      const activeCopy = copy[locale];
      gameTitle.textContent = game.lost ? activeCopy.lost : activeCopy.won;
      gameResult.textContent = `${activeCopy.score}: ${game.score}`;
      gameResult.hidden = false;
      gameMessage.hidden = true;
      gameRules.hidden = true;
      touchControls.hidden = true;
      gameOverlay.hidden = false;
      startButton.querySelector('.button__label').textContent = activeCopy.restart;
      updateGameOrientation();
    };

    const setLocale = (nextLocale) => {
      locale = nextLocale;
      page.dataset.locale = locale;
      document.documentElement.lang = locale;
      localStorage.setItem('lytvynenko-locale', locale);

      const activeCopy = copy[locale];
      copyElements.forEach((element) => {
        const key = element.dataset.copyKey;
        if (key && key in activeCopy) element.textContent = activeCopy[key];
      });
      localeButtons.forEach((button) => {
        const isActive = button.dataset.localeButton === locale;
        button.classList.toggle('is-active', isActive);
        if (isActive) button.setAttribute('aria-current', 'true');
        else button.removeAttribute('aria-current');
      });
      homeLink.href = locale === 'en' ? '/en/' : '/';
      homeLink.setAttribute('aria-label', activeCopy.homeAria);
      homeButton.href = homeLink.href;
      document.querySelector('.not-found-language')?.setAttribute('aria-label', activeCopy.languageAria);
      startButton.querySelector('.button__label').textContent = game.started ? activeCopy.restart : activeCopy.start;
      homeButton.querySelector('.button__label').textContent = activeCopy.home;
      touchControls.querySelector('[data-control="left"]')?.setAttribute('aria-label', activeCopy.touchLeft);
      touchControls.querySelector('[data-control="shoot"]')?.setAttribute('aria-label', activeCopy.touchShoot);
      touchControls.querySelector('[data-control="right"]')?.setAttribute('aria-label', activeCopy.touchRight);
      updateScore();
      if (game.started && (game.lost || game.won)) showFinishedOverlay();
      else if (game.started) drawGame();
      else {
        gameTitle.textContent = activeCopy.title;
        gameResult.hidden = true;
        gameMessage.hidden = false;
        gameRules.hidden = false;
        gameOverlay.hidden = false;
        drawStatic404();
      }
    };

    const hitTest = (a, b) => a.x < b.x + b.width && a.x + a.width > b.x && a.y < b.y + b.height && a.y + a.height > b.y;

    const resetGame = () => {
      window.cancelAnimationFrame(game.frame);
      setGameSize();
      game.started = true;
      game.running = true;
      game.lost = false;
      game.won = false;
      game.score = 0;
      game.level = 0;
      game.direction = 1;
      game.moveTimer = 0;
      game.lastFrame = 0;
      game.lastShot = 0;
      game.invaderSpeed = 20;
      game.invaderAttackRate = 0.999;
      game.playerX = game.gameSize.width / 2 - 8;
      game.playerY = game.gameSize.height - 16;
      game.invaders = createInvaders();
      game.bullets = [];
      game.controls.clear();
      game.touchGesture.active = false;
      game.touchGesture.pointerId = null;
      game.touchGesture.moved = false;
      gameTitle.textContent = copy[locale].title;
      gameResult.hidden = true;
      gameMessage.hidden = false;
      gameRules.hidden = isTouchDevice();
      gameOverlay.hidden = true;
      gameHud.hidden = false;
      touchControls.hidden = false;
      startButton.querySelector('.button__label').textContent = copy[locale].restart;
      updateGameOrientation();
      updateScore();
    };

    const drawGame = () => {
      context.clearRect(0, 0, canvas.width, canvas.height);
      context.fillStyle = '#fff';
      context.fillRect(0, 0, canvas.width, canvas.height);
      drawPoints();
      drawPlayer();
      game.invaders.filter((invader) => invader.active).forEach(drawInvader);
      game.bullets.filter((bullet) => bullet.active).forEach(drawBullet);
    };

    const createBullet = (x, y, velocity, fromPlayer) => ({ x, y, velocity, fromPlayer, width: 3, height: 3, active: true });

    const tryPlayerShot = (now) => {
      if (!game.running || now - game.lastShot <= 210) return;
      game.bullets.push(createBullet(game.playerX + 6, game.playerY - 5, -420, true));
      game.lastShot = now;
    };

    const updateGame = (delta, now) => {
      const speed = 120;
      if (game.controls.has('left')) game.playerX -= speed * delta;
      if (game.controls.has('right')) game.playerX += speed * delta;
      game.playerX = Math.max(0, Math.min(game.gameSize.width - 16, game.playerX));

      if (game.controls.has('shoot') && now - game.lastShot > 210) {
        tryPlayerShot(now);
      }

      game.bullets.forEach((bullet) => {
        bullet.y += bullet.velocity * delta;
        if (bullet.y > game.gameSize.height || bullet.y < 0) bullet.active = false;
      });

      game.moveTimer += delta * 1000;
      const moveInterval = Math.max(260, 1000 - game.level * 1.8);
      if (game.moveTimer >= moveInterval) {
        game.moveTimer = 0;
        const active = game.invaders.filter((invader) => invader.active);
        const edge = active.some((invader) => game.direction > 0
          ? invader.x + invader.width + game.invaderSpeed > game.gameSize.width
          : invader.x - game.invaderSpeed < 0);
        if (edge) {
          game.direction *= -1;
          active.forEach((invader) => { invader.y += invader.height; });
        } else {
          active.forEach((invader) => { invader.x += game.direction * game.invaderSpeed; });
        }
      }

      const lowestByColumn = {};
      game.invaders.filter((invader) => invader.active).forEach((invader) => {
        const column = invader.x;
        if (!lowestByColumn[column] || lowestByColumn[column].y < invader.y) lowestByColumn[column] = invader;
      });
      Object.values(lowestByColumn).forEach((invader) => {
        if (Math.random() > game.invaderAttackRate) game.bullets.push(createBullet(invader.x + 8, invader.y + 20, 140, false));
      });

      game.bullets.filter((bullet) => bullet.active && bullet.fromPlayer).forEach((bullet) => {
        const target = game.invaders.find((invader) => invader.active && hitTest(bullet, invader));
        if (target) {
          target.active = false;
          bullet.active = false;
          game.score += 1;
        }
      });
      game.bullets.filter((bullet) => bullet.active && !bullet.fromPlayer).forEach((bullet) => {
        if (hitTest(bullet, { x: game.playerX, y: game.playerY - 4, width: 16, height: 12 })) {
          game.lost = true;
          game.running = false;
        }
      });

      if (game.invaders.some((invader) => invader.active && invader.y + invader.height >= game.playerY)) {
        game.lost = true;
        game.running = false;
      }
      if (game.invaders.length > 0 && game.invaders.every((invader) => !invader.active)) {
        game.won = true;
        game.running = false;
      }
      if (game.lost || game.won) {
        showFinishedOverlay();
      }
      game.bullets = game.bullets.filter((bullet) => bullet.active);
      updateScore();
    };

    const loop = (now) => {
      if (!game.running) {
        drawGame();
        return;
      }
      const delta = Math.min((now - game.lastFrame) / 1000 || 0, 0.05);
      game.lastFrame = now;
      updateGame(delta, now);
      drawGame();
      game.frame = window.requestAnimationFrame(loop);
    };

    const setControl = (control, active) => {
      if (active) game.controls.add(control);
      else game.controls.delete(control);
    };

    const movePlayerByTouch = (event) => {
      const rect = canvas.getBoundingClientRect();
      if (!rect.width) return;
      const deltaX = (event.clientX - game.touchGesture.lastX) * (game.gameSize.width / rect.width);
      if (Math.abs(event.clientX - game.touchGesture.startX) > 8) game.touchGesture.moved = true;
      game.playerX = Math.max(0, Math.min(game.gameSize.width - 16, game.playerX + deltaX));
      game.touchGesture.lastX = event.clientX;
    };

    canvas.addEventListener('pointerdown', (event) => {
      if (!game.running || event.pointerType !== 'touch' || game.touchGesture.active) return;
      event.preventDefault();
      game.touchGesture.active = true;
      game.touchGesture.pointerId = event.pointerId;
      game.touchGesture.startX = event.clientX;
      game.touchGesture.lastX = event.clientX;
      game.touchGesture.moved = false;
      canvas.setPointerCapture?.(event.pointerId);
    });

    canvas.addEventListener('pointermove', (event) => {
      if (!game.touchGesture.active || event.pointerType !== 'touch' || event.pointerId !== game.touchGesture.pointerId) return;
      event.preventDefault();
      movePlayerByTouch(event);
    });

    const finishTouchGesture = (event) => {
      if (!game.touchGesture.active || event.pointerType !== 'touch' || event.pointerId !== game.touchGesture.pointerId) return;
      event.preventDefault();
      if (!game.touchGesture.moved) tryPlayerShot(performance.now());
      game.touchGesture.active = false;
      game.touchGesture.pointerId = null;
      canvas.releasePointerCapture?.(event.pointerId);
    };

    canvas.addEventListener('pointerup', finishTouchGesture);
    canvas.addEventListener('pointercancel', finishTouchGesture);

    const keyMap = { ArrowLeft: 'left', ArrowRight: 'right', ' ': 'shoot', Spacebar: 'shoot' };
    window.addEventListener('keydown', (event) => {
      const control = keyMap[event.key];
      if (!control || !game.started) return;
      event.preventDefault();
      setControl(control, true);
    });
    window.addEventListener('keyup', (event) => {
      const control = keyMap[event.key];
      if (control) setControl(control, false);
    });

    touchControls.querySelectorAll('[data-control]').forEach((button) => {
      const control = button.dataset.control;
      button.addEventListener('pointerdown', (event) => { event.preventDefault(); setControl(control, true); });
      button.addEventListener('pointerup', () => setControl(control, false));
      button.addEventListener('pointerleave', () => setControl(control, false));
      button.addEventListener('pointercancel', () => setControl(control, false));
    });

    localeButtons.forEach((button) => button.addEventListener('click', () => {
      const nextLocale = button.dataset.localeButton;
      if (nextLocale === 'uk' || nextLocale === 'en') setLocale(nextLocale);
    }));

    startButton.addEventListener('click', () => {
      if (game.startPending) return;
      if (isTouchPortrait() && !game.started) showOrientationPrompt();
      else startGame();
    });

    window.addEventListener('resize', () => {
      if (game.started) {
        if (game.lost || game.won) {
          setGameSize();
          updateGameOrientation();
          showFinishedOverlay();
        } else {
          resetGame();
        }
        drawGame();
        if (game.running) game.frame = window.requestAnimationFrame(loop);
      } else {
        setGameSize();
        game.invaders = createInvaders();
        drawStatic404();
      }
      if (game.started) updateGameOrientation();
    });

    setGameSize();
    game.invaders = createInvaders();
    setLocale(locale);
  }
</script>
