---
import type { Locale } from '../../content/site';
import { homePath } from '../../lib/routes';

interface Props { locale: Locale; }

const { locale } = Astro.props;
const copy = locale === 'uk'
  ? {
      back: 'Назад',
      heroAlt: 'Мобільний застосунок Complexity із пошуком місць, відгуками на напої та функціями спільноти',
      overview: 'Огляд проєкту',
      description: 'Complexity — це мобільний застосунок, який поєднує пошук місць поблизу, відгуки на напої та функції спільноти в одному досвіді. Починаючи з ранньої концепції, я переробила наявну основу, структурувала користувацький досвід і розширила його до масштабованого MVP, готового до подальшого розвитку.',
      details: [
        ['Сфера', 'Соціальні сервіси · Lifestyle · Wellness'],
        ['Роль у проєкті', 'Product Designer'],
        ['Дата', '2025'],
        ['Платформа', 'Кросплатформний мобільний застосунок'],
      ],
    }
  : {
      back: 'Back',
      heroAlt: 'Complexity mobile app with venue discovery, beverage reviews, and community features',
      overview: 'Project overview',
      description: 'Complexity is a mobile app that combines location-based discovery, beverage reviews, and community features into a single experience. Starting from an early concept, I redesigned the existing foundation, restructured the user experience, and expanded it into a scalable MVP ready for future growth.',
      details: [
        ['Industry', 'Social · Lifestyle · Wellness'],
        ['Role', 'Product Designer'],
        ['Date', '2025'],
        ['Platform', 'Cross-platform Mobile App'],
      ],
    };

const backHref = homePath(locale);
---

<div class="complexity-intro">
  <section class="complexity-intro__hero" aria-labelledby="complexity-title" data-case-title-container>
    <a class="complexity-intro__back" href={backHref} aria-label={copy.back} title={copy.back} data-case-back>
      <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
        <path d="M15 8H1M1 8l6-6M1 8l6 6" />
      </svg>
    </a>
    <h1 id="complexity-title" data-case-title>Complexity</h1>
    <picture class="complexity-intro__picture">
      <img
        class="complexity-intro__image"
        src="/images/cases/complexity-hero.png"
        alt={copy.heroAlt}
        width="5120"
        height="3696"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </picture>
  </section>

  <section class="complexity-intro__overview" aria-labelledby="complexity-overview-title">
    <div class="complexity-intro__overview-copy">
      <h2 id="complexity-overview-title">{copy.overview}</h2>
      <p>{copy.description}</p>
    </div>
    <dl class="complexity-intro__details">
      {copy.details.map(([label, value], index) => (
        <div class:list={['complexity-intro__detail', index === 0 && 'complexity-intro__detail--industry', index === 1 && 'complexity-intro__detail--role', index === 2 && 'complexity-intro__detail--date', index === 3 && 'complexity-intro__detail--platform']}>
          <dt>{label}</dt>
          <dd>{value}</dd>
        </div>
      ))}
    </dl>
  </section>
</div>

<style>
  .complexity-intro,
  .complexity-intro h1,
  .complexity-intro h2,
  .complexity-intro p,
  .complexity-intro dl,
  .complexity-intro dd { margin: 0; }
  .complexity-intro { display: flex; width: 100%; flex-direction: column; gap: 120px; }
  .complexity-intro__hero { position: relative; width: 100%; }
  .complexity-intro h1 {
    color: var(--color-text-primary); font-size: var(--font-display-size); font-weight: var(--font-display-weight);
    line-height: var(--font-display-line); letter-spacing: var(--font-display-tracking); text-align: center;
  }
  .complexity-intro__picture { display: block; width: 100%; margin-top: 40px; }
  .complexity-intro__image { display: block; width: 100%; height: auto; }
  .complexity-intro__back {
    --case-back-inline-offset: 0px;
    position: absolute; top: var(--case-title-center-y); left: 0; display: grid; width: 64px; height: 40px; place-items: center;
    transform: translateY(-50%);
    border: .5px solid var(--color-foundation-navy-300); border-radius: var(--radius-full); color: var(--color-text-primary);
  }
  .complexity-intro__back svg { width: 16px; height: 16px; }
  .complexity-intro__back path { fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.25; }
  .complexity-intro__hero.case-title-container--stack-back { display: flex; flex-direction: column; align-items: stretch; }
  .complexity-intro__hero.case-title-container--stack-back .complexity-intro__back { position: static; align-self: flex-start; margin-bottom: 4px; transform: none; }
  .complexity-intro__overview { display: grid; grid-template-columns: 38.2% 49.1%; justify-content: space-between; }
  .complexity-intro__overview-copy { display: flex; flex-direction: column; gap: 40px; }
  .complexity-intro h2 { color: var(--color-text-tertiary); font-size: var(--font-headline-size); font-weight: var(--font-headline-weight); line-height: var(--font-headline-line); letter-spacing: var(--font-headline-tracking); }
  .complexity-intro__overview-copy p { color: var(--color-text-primary); font-size: var(--font-body-size); font-weight: var(--font-body-weight); line-height: var(--font-body-line); letter-spacing: var(--font-body-tracking); }
  .complexity-intro__details { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2px; padding: 11px 0 0; }
  .complexity-intro__detail { display: flex; min-height: 122px; flex-direction: column; justify-content: space-between; padding: 20px 28px; border: 1px solid #657bd4; border-radius: 16px; color: var(--color-text-primary); }
  .complexity-intro__detail dt { color: var(--color-text-tertiary); font-size: var(--font-caption-semibold-size); font-weight: var(--font-caption-semibold-weight); line-height: var(--font-caption-semibold-line); }
  .complexity-intro__detail dd { font-size: var(--font-body-semibold-size); font-weight: var(--font-body-semibold-weight); line-height: var(--font-body-semibold-line); }

  @media (min-width: 641px) and (max-width: 1024px) {
    .complexity-intro { gap: 80px; }
    .complexity-intro h1 { font-size: 64px; line-height: 82px; letter-spacing: -1.92px; }
    .complexity-intro__picture { margin-top: 48px; aspect-ratio: 1280 / 924; overflow: hidden; border-radius: 16px; }
    .complexity-intro__image { height: 100%; object-fit: cover; }
    .complexity-intro__overview { display: flex; flex-direction: column; gap: 48px; }
    .complexity-intro__details { padding-top: 0; }
    .complexity-intro__detail { min-height: 122px; padding: 20px 24px; border-radius: 12px; }
  }

  @media (max-width: 640px) {
    .complexity-intro { gap: 80px; }
    .complexity-intro h1 { font-size: 40px; line-height: 40px; letter-spacing: -1.2px; }
    .complexity-intro__back { width: 40px; height: 40px; }
    .complexity-intro__picture { margin-top: 32px; aspect-ratio: 358 / 258.43; overflow: hidden; border-radius: 8px; }
    .complexity-intro__image { height: 100%; object-fit: cover; }
    .complexity-intro__overview { display: flex; flex-direction: column; gap: 32px; }
    .complexity-intro__overview-copy { gap: 32px; }
    .complexity-intro__details { grid-template-columns: 1fr; gap: 4px; padding-top: 0; }
    .complexity-intro__detail { min-height: 94px; padding: 12px 16px; border-radius: 10px; }
    .complexity-intro__detail--industry { order: 1; }
    .complexity-intro__detail--role { order: 2; }
    .complexity-intro__detail--platform { order: 3; }
    .complexity-intro__detail--date { order: 4; }
  }
</style>
