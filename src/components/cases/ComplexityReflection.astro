---
import type { Locale } from '../../content/site';
import TimelineStep from '../ui/TimelineStep.astro';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const copy = locale === 'uk'
  ? {
      title: 'Етапи роботи',
      paragraphs: [
        'Оскільки ключовою цільовою аудиторією була спільнота людей, які обирають безалкогольний спосіб життя, моя пропозиція оформити застосунок у форматі соціальної мережі знайшла позитивний відгук у клієнта й логічно доповнила визначені пріоритети функціоналу. Поєднавши соціальні взаємодії, пошук місць поблизу та контент від спільноти, я сформувала MVP з гнучкою основою для подальшого розвитку.',
      ],
      steps: ['Аналіз функціоналу та архітектура застосунку', 'Проєктування масштабованих user flows', 'Проєктування інтерфейсів і їхніх станів', 'Розробка UI kit для консистентності й масштабованості', 'Підготовка дизайн-специфікацій для розробки'],
    }
  : {
      title: 'Design Process',
      paragraphs: [
        'Because the core audience was a community of people who choose a non-alcoholic lifestyle, my proposal to shape the app as a social network received positive feedback from the client and aligned naturally with the previously defined feature priorities. By combining social interactions, location-based discovery, and community-generated content, I shaped an MVP with a flexible foundation for future development.',
      ],
      steps: ['Feature analysis and app architecture', 'Designing scalable user flows', 'Interface design and state definition', 'UI kit for consistency and scalability', 'Preparing design specifications for development'],
    };
const steps = copy.steps.map((description, index) => ({ stepLabel: `${locale === 'uk' ? 'Крок' : 'Step'} ${String(index + 1).padStart(2, '0')}`, description }));
---

<section class="complexity-reflection" aria-labelledby="complexity-reflection-title">
  <header class="complexity-reflection__intro">
    <h2 id="complexity-reflection-title">{copy.title}</h2>
    <div class="complexity-reflection__paragraphs">
      {copy.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </header>
  <ol class="complexity-reflection__timeline" aria-label={locale === 'uk' ? 'Етапи розвитку проєкту' : 'Project development stages'}>
    {steps.map((step) => (
      <li class="complexity-reflection__stage">
        <div class="complexity-reflection__stage-copy"><TimelineStep stepLabel={step.stepLabel} description={step.description} /></div>
        <span class="complexity-reflection__dot" aria-hidden="true"></span>
      </li>
    ))}
  </ol>
</section>

<style>
  .complexity-reflection,
  .complexity-reflection h2,
  .complexity-reflection p,
  .complexity-reflection ol { margin: 0; }
  .complexity-reflection { display: flex; width: 100%; flex-direction: column; gap: 120px; }
  .complexity-reflection__intro { display: flex; flex-direction: column; gap: 48px; }
  .complexity-reflection h2 { color: var(--color-text-tertiary); font-size: var(--font-headline-size); font-weight: var(--font-headline-weight); line-height: var(--font-headline-line); letter-spacing: var(--font-headline-tracking); }
  .complexity-reflection__paragraphs { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 104px; }
  .complexity-reflection__paragraphs p { color: var(--color-text-primary); font-size: var(--font-body-size); font-weight: var(--font-body-weight); line-height: var(--font-body-line); letter-spacing: var(--font-body-tracking); }
  .complexity-reflection__timeline { position: relative; display: grid; width: 100%; height: 280px; grid-template-columns: repeat(5, minmax(0, 1fr)); padding: 0; list-style: none; }
  .complexity-reflection__timeline::before { position: absolute; z-index: 0; top: 139px; left: 10%; width: 80%; height: 2px; background: #d9d9d9; content: ''; }
  .complexity-reflection__stage { position: relative; z-index: 1; display: grid; min-width: 0; grid-template-rows: 120px 40px 120px; }
  .complexity-reflection__stage-copy { display: flex; min-width: 0; align-items: center; justify-content: center; padding-inline: 12px; text-align: center; }
  .complexity-reflection__stage:nth-child(odd) .complexity-reflection__stage-copy { grid-row: 1; padding-bottom: 12px; }
  .complexity-reflection__stage:nth-child(even) .complexity-reflection__stage-copy { grid-row: 3; }
  .complexity-reflection__dot { z-index: 1; display: block; width: 18px; height: 18px; grid-row: 2; align-self: center; justify-self: center; border-radius: 50%; background: #657bd4; box-shadow: inset 0 0 0 3px #fff; }
  .complexity-reflection__stage-copy :global(.timeline-step) { width: 100%; text-align: center; }
  .complexity-reflection__stage-copy :global(.timeline-step__label),
  .complexity-reflection__stage-copy :global(.timeline-step__description) { display: block; width: 100%; }

  @media (min-width: 641px) and (max-width: 1024px) {
    .complexity-reflection { gap: 120px; }
    .complexity-reflection__paragraphs { grid-template-columns: 1fr; gap: 24px; }
  }
  @media (max-width: 640px) {
    .complexity-reflection { gap: 32px; }
    .complexity-reflection__intro { gap: 32px; }
    .complexity-reflection__paragraphs { grid-template-columns: 1fr; gap: 24px; }
    .complexity-reflection__timeline { height: auto; grid-template-columns: 1fr; grid-auto-rows: minmax(60px, auto); row-gap: 12px; }
    .complexity-reflection__timeline::before { top: 30px; left: 8px; width: 1px; height: calc(100% - 60px); }
    .complexity-reflection__stage { display: grid; grid-template-columns: 18px minmax(0, 1fr); grid-template-rows: minmax(60px, auto); column-gap: 16px; align-items: center; }
    .complexity-reflection__stage-copy,
    .complexity-reflection__stage:nth-child(odd) .complexity-reflection__stage-copy,
    .complexity-reflection__stage:nth-child(even) .complexity-reflection__stage-copy { min-width: 0; grid-row: 1; grid-column: 2; justify-content: flex-start; padding: 0; text-align: left; }
    .complexity-reflection__stage-copy :global(.timeline-step) { display: flex; align-items: center; gap: 24px; text-align: left; }
    .complexity-reflection__stage-copy :global(.timeline-step__label) { width: auto; flex: 0 0 auto; color: #808080; font-size: var(--font-caption-size); font-weight: var(--font-caption-weight); line-height: var(--font-caption-line); letter-spacing: var(--font-caption-tracking); }
    .complexity-reflection__stage-copy :global(.timeline-step__description) { width: auto; flex: 1 1 auto; min-width: 0; font-size: var(--font-body-semibold-size); font-weight: var(--font-body-semibold-weight); line-height: var(--font-body-semibold-line); letter-spacing: var(--font-body-semibold-tracking); }
    .complexity-reflection__dot { width: 12px; height: 12px; grid-row: 1; grid-column: 1; }
  }
</style>
