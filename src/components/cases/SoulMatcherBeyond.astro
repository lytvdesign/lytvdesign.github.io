---
import type { Locale } from '../../content/site';
import TimelineStep from '../ui/TimelineStep.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const content = locale === 'uk'
  ? {
      title: 'Етапи роботи',
      description: 'Окрім проєктування інтерфейсів, я перетворила технічну концепцію продукту на орієнтований на людей досвід взаємодії зі ШІ: переосмислила сценарії взаємодії, спростила онбординг, створила масштабований діалоговий потік і розробила кастомізовану дизайн-систему для подальшого масштабування та консистентності продукту.',
      steps: [
        'Ідея клієнта',
        'UX-стратегія',
        'Діалогові сценарії',
        'Проєктування екранів і кастомної дизайн-системи',
        'Масштабований MVP',
      ],
    }
  : {
      title: 'Design Process',
      description: 'Beyond designing interfaces, I translated a technical product concept into a user-centered AI experience by redefining interaction patterns, simplifying onboarding, creating a scalable conversational flow, and developing a custom design system to support product scalability and consistency.',
      steps: [
        'Client Idea',
        'UX Strategy',
        'Conversational Flows',
        'Screen design and custom design system',
        'Scalable MVP',
      ],
    };

const steps = content.steps.map((description, index) => ({
  stepLabel: `Step ${String(index + 1).padStart(2, '0')}`,
  description,
}));

if (locale === 'uk') {
  steps.forEach((step, index) => {
    step.stepLabel = `Крок ${String(index + 1).padStart(2, '0')}`;
  });
}
---

<section class="soulmatcher-beyond" aria-labelledby="soulmatcher-beyond-title">
  <header class="soulmatcher-beyond__intro">
    <h2 id="soulmatcher-beyond-title">{content.title}</h2>
    <p>{content.description}</p>
  </header>

  <ol class="soulmatcher-beyond__timeline" aria-label={locale === 'uk' ? 'Етапи розвитку проєкту' : 'Project development stages'}>
    {steps.map((step) => (
      <li class="soulmatcher-beyond__stage">
        <div class="soulmatcher-beyond__stage-copy">
          <TimelineStep stepLabel={step.stepLabel} description={step.description} />
        </div>
        <span class="soulmatcher-beyond__dot" aria-hidden="true"></span>
      </li>
    ))}
  </ol>
</section>

<style>
  .soulmatcher-beyond {
    display: flex;
    width: 100%;
    flex-direction: column;
    gap: 120px;
  }

  .soulmatcher-beyond__intro {
    display: flex;
    width: 100%;
    flex-direction: column;
    align-items: flex-start;
    gap: 48px;
  }

  .soulmatcher-beyond__intro h2,
  .soulmatcher-beyond__intro p {
    margin: 0;
  }

  .soulmatcher-beyond__intro h2 {
    width: 100%;
    color: var(--color-text-tertiary);
    font-size: var(--font-headline-size);
    font-weight: var(--font-headline-weight);
    line-height: var(--font-headline-line);
    letter-spacing: var(--font-headline-tracking);
  }

  .soulmatcher-beyond__intro p {
    width: 100%;
    max-width: 820px;
    color: var(--color-text-primary);
    font-size: var(--font-body-size);
    font-weight: var(--font-body-weight);
    line-height: var(--font-body-line);
    letter-spacing: var(--font-body-tracking);
  }

  .soulmatcher-beyond__timeline {
    position: relative;
    display: grid;
    width: 100%;
    height: 280px;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .soulmatcher-beyond__timeline::before {
    position: absolute;
    z-index: 0;
    top: 139px;
    left: 10%;
    width: 80%;
    height: 2px;
    background: #d9d9d9;
    content: '';
  }

  .soulmatcher-beyond__stage {
    position: relative;
    z-index: 1;
    display: grid;
    min-width: 0;
    grid-template-rows: 120px 40px 120px;
  }

  .soulmatcher-beyond__stage-copy {
    display: flex;
    min-width: 0;
    align-items: center;
    justify-content: center;
    padding-inline: 12px;
    text-align: center;
  }

  .soulmatcher-beyond__stage:nth-child(odd) .soulmatcher-beyond__stage-copy {
    grid-row: 1;
    padding-bottom: 12px;
  }

  .soulmatcher-beyond__stage:nth-child(even) .soulmatcher-beyond__stage-copy {
    grid-row: 3;
  }

  .soulmatcher-beyond__dot {
    z-index: 1;
    display: block;
    width: 18px;
    height: 18px;
    grid-row: 2;
    align-self: center;
    justify-self: center;
    border-radius: 50%;
    background: #c6a15a;
    box-shadow: inset 0 0 0 3px #fff;
  }

  .soulmatcher-beyond__stage-copy :global(.timeline-step) {
    width: 100%;
    text-align: center;
  }

  .soulmatcher-beyond__stage-copy :global(.timeline-step__label),
  .soulmatcher-beyond__stage-copy :global(.timeline-step__description) {
    display: block;
    width: 100%;
  }

  @media (max-width: 647px) {
    .soulmatcher-beyond {
      gap: 32px;
      --font-headline-size: 32px;
      --font-headline-line: 40px;
      --font-headline-tracking: -.5px;
      --font-caption-semibold-size: 13px;
      --font-caption-semibold-line: 20px;
      --font-overline-size: 11px;
      --font-overline-line: 16px;
    }

    .soulmatcher-beyond__intro {
      gap: 32px;
    }

    .soulmatcher-beyond__intro p {
      font-size: var(--font-body-size);
      line-height: var(--font-body-line);
    }

    .soulmatcher-beyond__timeline {
      position: relative;
      height: auto;
      grid-template-columns: minmax(0, 1fr);
      grid-auto-rows: minmax(60px, auto);
      row-gap: 24px;
    }

    .soulmatcher-beyond__timeline::before {
      top: 30px;
      left: 8px;
      width: 1px;
      height: calc(100% - 60px);
    }

    .soulmatcher-beyond__stage {
      display: grid;
      height: auto;
      grid-template-columns: 18px minmax(0, 1fr);
      grid-template-rows: minmax(60px, auto);
      column-gap: 16px;
      align-items: center;
    }

    .soulmatcher-beyond__stage-copy,
    .soulmatcher-beyond__stage:nth-child(odd) .soulmatcher-beyond__stage-copy,
    .soulmatcher-beyond__stage:nth-child(even) .soulmatcher-beyond__stage-copy {
      min-width: 0;
      grid-row: 1;
      grid-column: 2;
      justify-content: center;
      padding: 0;
      text-align: left;
    }

    .soulmatcher-beyond__stage-copy :global(.timeline-step) {
      display: flex;
      align-items: center;
      gap: 24px;
      text-align: left;
    }

    .soulmatcher-beyond__stage-copy :global(.timeline-step__label) {
      width: auto;
      flex: 0 0 auto;
      color: #808080;
      font-size: var(--font-caption-size);
      font-weight: var(--font-caption-weight);
      line-height: var(--font-caption-line);
      letter-spacing: var(--font-caption-tracking);
    }

    .soulmatcher-beyond__stage-copy :global(.timeline-step__description) {
      width: auto;
      flex: 1 1 auto;
      min-width: 0;
      font-size: var(--font-body-semibold-size);
      font-weight: var(--font-body-semibold-weight);
      line-height: var(--font-body-semibold-line);
      letter-spacing: var(--font-body-semibold-tracking);
    }

    .soulmatcher-beyond__dot {
      width: 12px;
      height: 12px;
      grid-row: 1;
      grid-column: 1;
      align-self: center;
      justify-self: center;
      margin: 0;
    }
  }

  @media (max-width: 360px) {
    .soulmatcher-beyond__stage-copy :global(.timeline-step__description) { overflow-wrap: anywhere; }
  }
</style>
