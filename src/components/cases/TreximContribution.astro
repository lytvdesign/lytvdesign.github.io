---
import type { Locale } from '../../content/site';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const title = locale === 'uk' ? 'Мій внесок' : 'My contribution';
const skills = ['Information Architecture', 'User Flows', 'Wireframing', 'UX Design', 'UI Design', 'Design System', 'Interactive Prototypes', 'Responsive Design', 'UX Writing'];
---

<section class="trexim-contribution" aria-labelledby="trexim-contribution-title">
  <h2 id="trexim-contribution-title">{title}</h2>
  <ul>
    {skills.map((skill) => <li>{skill}</li>)}
  </ul>
</section>

<style>
  .trexim-contribution { display: flex; width: 100%; min-height: 272px; align-items: flex-start; justify-content: space-between; gap: 40px; padding: 80px 0; }
  .trexim-contribution h2,
  .trexim-contribution ul,
  .trexim-contribution li { margin: 0; }
  .trexim-contribution h2 { color: var(--color-text-tertiary); font-size: var(--font-headline-size); font-weight: var(--font-headline-weight); line-height: var(--font-headline-line); letter-spacing: var(--font-headline-tracking); white-space: nowrap; }
  .trexim-contribution ul { display: flex; width: 633px; flex: 0 0 633px; flex-wrap: wrap; gap: 8px; align-items: center; justify-content: center; padding: 0; list-style: none; }
  .trexim-contribution li { display: inline-flex; align-items: center; padding: 4px 16px; border-radius: var(--radius-full); background: var(--color-status-info-bg); color: var(--color-accent-primary); font-size: var(--font-label-size); font-weight: var(--font-label-weight); line-height: var(--font-label-line); letter-spacing: var(--font-label-tracking); white-space: nowrap; }
  @media (min-width: 641px) and (max-width: 1024px) {
    .trexim-contribution { min-height: 204px; flex-direction: column; gap: 48px; padding: 0; }
    .trexim-contribution ul { width: 100%; flex: 0 1 auto; align-content: flex-start; justify-content: flex-start; }
  }
  @media (max-width: 640px) {
    .trexim-contribution { min-height: 208px; flex-direction: column; gap: 24px; padding: 0; }
    .trexim-contribution h2 { white-space: normal; }
    .trexim-contribution ul { width: 100%; flex: 0 1 auto; align-content: flex-start; justify-content: flex-start; }
    .trexim-contribution li { padding: 3px 12px; }
  }
</style>
