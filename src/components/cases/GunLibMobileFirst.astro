---
import type { Locale } from '../../content/site';
import { getProgressiveImagePath } from '../../lib/images';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const content = {
  uk: {
    title: 'Мобільний трафік домінує — це підтримує Mobile-First пріоритет:',
    description:
      'На етапі дослідження ми висунули гіпотезу, що ключовий контекст використання GunLib — це швидкий пошук ТТХ, інструкцій та схем пристрілки безпосередньо у польових умовах або на навчальних локаціях.',
    introBefore: 'У звіті Google Analytics 4 за орієнтовний період 13 липня — 11 серпня мобільний трафік становив ',
    introMetric: '(78.05%)',
    introAfter: ', що підтримує mobile-first пріоритет. Водночас дані показують відмінності в глибині взаємодії:',
    image: '/images/cases/gunlib-mobile-traffic.png',
    imageAlt: 'Звіт Google Analytics 4 про мобільний і десктопний трафік GunLib',
    imageWidth: 1608,
    imageHeight: 844,
    points: [
      {
        title: 'Вища частка залучених сесій (51.0% проти 44.24%):',
        body: 'Engagement rate на мобільних трохи вищий за desktop. Середній час взаємодії становить 1:27 проти 2:04. Цей сигнал допомагає визначити mobile-first напрям: далі варто перевірити, як різні мобільні сценарії впливають на глибину взаємодії.',
      },
      {
        title: 'Мобільний — основний пристрій нових користувачів (79.03%):',
        body: "Близько 80% нових користувачів уперше відкривали GunLib зі смартфона. Це підсилює рішення про миттєвий доступ без обов'язкової реєстрації. Наступним кроком стане перевірка ефективності цього підходу у воронці.",
      },
      {
        title: 'Робоча гіпотеза про різні сценарії пристроїв:',
        body: 'Мобільна версія може підтримувати швидкі точкові задачі в полі, тоді як desktop — тривале дослідження й підготовку матеріалів. Для наступної ітерації плануємо зіставити ці сценарії з даними про шляхи, контент і завершення задач.',
      },
    ],
  },
  en: {
    title: 'Mobile traffic dominates — supporting the Mobile-First priority:',
    description:
      'During the research stage, we hypothesized that GunLib’s key usage context was the quick search for technical specifications, instructions, and sighting-in diagrams directly in the field or at training locations.',
    introBefore: 'In the Google Analytics 4 report, covering approximately 13 July — 11 August, mobile traffic accounted for ',
    introMetric: '(78.05%)',
    introAfter: ', supporting the Mobile-First priority. At the same time, the data shows differences in interaction depth:',
    image: '/images/cases/gunlib-mobile-traffic.png',
    imageAlt: 'Google Analytics 4 report comparing GunLib mobile and desktop traffic',
    imageWidth: 1608,
    imageHeight: 844,
    points: [
      {
        title: 'Higher share of engaged sessions (51.0% vs 44.24%):',
        body: 'The mobile engagement rate is slightly higher than desktop. Average engagement time is 1:27 versus 2:04. This signal helps define the Mobile-First direction; the next step is to explore how different mobile scenarios affect interaction depth.',
      },
      {
        title: 'Mobile is the primary device for new users (79.03%):',
        body: 'Around 80% of new users first opened GunLib on a smartphone. This supports providing instant access without mandatory registration. The next step is to check the effectiveness of this approach through a separate funnel.',
      },
      {
        title: 'A working hypothesis about different device scenarios:',
        body: 'The mobile version may support quick, focused tasks in the field, while desktop may serve extended research and preparation of materials. In the next iteration, we plan to compare these scenarios with path, content, and task-completion data.',
      },
    ],
  },
} as const;

const copy = content[locale];
---

<section class="gunlib-mobile-first" aria-labelledby="gunlib-mobile-first-title">
  <div class="gunlib-mobile-first__title-row">
    <h2 id="gunlib-mobile-first-title">{copy.title}</h2>
    <p>{copy.description}</p>
  </div>

  <div class="gunlib-mobile-first__content">
    <div class="gunlib-mobile-first__analysis">
      <p class="gunlib-mobile-first__intro">
        {copy.introBefore}<strong>{copy.introMetric}</strong>{copy.introAfter}
      </p>

      <div class="gunlib-mobile-first__points">
        {copy.points.map((point) => (
          <div class="gunlib-mobile-first__point">
            <img src="/images/cases/gunlib-check-circle.svg" alt="" aria-hidden="true" width="16" height="24" />
            <p>
              <strong>{point.title}</strong>
              <span>{point.body}</span>
            </p>
          </div>
        ))}
      </div>
    </div>

    <figure class="gunlib-mobile-first__image">
      <img
        src={getProgressiveImagePath(copy.image, 'optimized')}
        data-progressive-src={getProgressiveImagePath(copy.image, 'optimized')}
        alt={copy.imageAlt}
        width={copy.imageWidth}
        height={copy.imageHeight}
        loading="lazy"
        decoding="async"
      />
    </figure>
  </div>
</section>

<style>
  .gunlib-mobile-first {
    display: flex;
    width: 100%;
    flex-direction: column;
    gap: var(--space-16);
    color: var(--color-text-primary);
  }

  .gunlib-mobile-first h2,
  .gunlib-mobile-first p,
  .gunlib-mobile-first figure {
    margin: 0;
  }

  .gunlib-mobile-first__title-row {
    display: grid;
    grid-template-columns: 465px minmax(0, 1fr);
    gap: var(--space-6);
    width: 100%;
    align-items: start;
  }

  .gunlib-mobile-first h2 {
    color: var(--color-text-primary);
    font-size: var(--font-title-size);
    font-weight: var(--font-title-weight);
    line-height: var(--font-title-line);
    letter-spacing: var(--font-title-tracking);
  }

  .gunlib-mobile-first__title-row > p {
    color: var(--color-text-primary);
    font-size: var(--font-body-size);
    font-weight: var(--font-body-weight);
    line-height: var(--font-body-line);
    letter-spacing: var(--font-body-tracking);
  }

  .gunlib-mobile-first__content {
    display: grid;
    grid-template-columns: 428px minmax(0, 1fr);
    gap: var(--space-12);
    width: 100%;
    align-items: center;
  }

  .gunlib-mobile-first__analysis {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: var(--space-8);
    align-items: flex-start;
  }

  .gunlib-mobile-first__intro,
  .gunlib-mobile-first__point p {
    color: var(--color-text-primary);
    font-size: var(--font-caption-size);
    font-weight: var(--font-caption-weight);
    line-height: var(--font-caption-line);
    letter-spacing: var(--font-caption-tracking);
  }

  .gunlib-mobile-first__intro strong {
    font-weight: var(--font-caption-semibold-weight);
  }

  .gunlib-mobile-first__points {
    display: flex;
    width: 100%;
    flex-direction: column;
    gap: var(--space-6);
  }

  .gunlib-mobile-first__point {
    display: flex;
    width: 100%;
    gap: var(--space-3);
    align-items: flex-start;
  }

  .gunlib-mobile-first__point > img {
    display: block;
    flex: 0 0 16px;
    width: 16px;
    height: 24px;
  }

  .gunlib-mobile-first__point p {
    display: flex;
    min-width: 0;
    flex-direction: column;
  }

  .gunlib-mobile-first__point strong {
    font-weight: var(--font-caption-semibold-weight);
  }

  .gunlib-mobile-first__point span {
    font-weight: var(--font-caption-weight);
  }

  .gunlib-mobile-first__image {
    position: relative;
    width: 100%;
    height: 422px;
    overflow: hidden;
  }

  .gunlib-mobile-first__image > img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    max-width: none;
    height: 100%;
    object-fit: cover;
  }

  @media (min-width: 641px) and (max-width: 1024px) {
    .gunlib-mobile-first {
      gap: var(--space-8);
      margin-bottom: calc(-1 * var(--space-16));
    }

    .gunlib-mobile-first__title-row {
      display: flex;
      flex-direction: column;
      gap: var(--space-12);
    }

    .gunlib-mobile-first__content {
      display: flex;
      flex-direction: column;
      gap: var(--space-6);
      align-items: stretch;
    }

    .gunlib-mobile-first__analysis {
      gap: var(--space-8);
    }

    .gunlib-mobile-first__image {
      height: auto;
      aspect-ratio: 1113 / 585;
    }
  }

  @media (max-width: 640px) {
    .gunlib-mobile-first {
      gap: var(--space-8);
      margin-bottom: 0;
    }

    .gunlib-mobile-first__title-row {
      display: flex;
      flex-direction: column;
      gap: var(--space-12);
    }

    .gunlib-mobile-first__content {
      display: flex;
      flex-direction: column;
      gap: var(--space-6);
      align-items: stretch;
    }

    .gunlib-mobile-first__analysis {
      gap: var(--space-8);
    }

    .gunlib-mobile-first__points {
      gap: var(--space-6);
    }

    .gunlib-mobile-first__image {
      height: auto;
      aspect-ratio: 1113 / 585;
    }
  }
</style>
