        title: 'AARRR Funnel',
        description:
          'The pirate metrics funnel focuses on organic product growth and natural retention conditions without excessive spending.',
        image: '/images/cases/gunlib-research-aarrr-a.png',
        imageAlt: 'GunLib AARRR metrics funnel',
        points: [
          {
            title: 'Immediate value in the first session:',
            description:
              'Users get value immediately after searching for technical specifications, without mandatory registration, reducing the bounce rate.',
          },
          {
            title: 'Organic audience acquisition loop:',
            description:
              'Direct links to specific page sections help attract potential users through sharing useful information.',
          },
          {
            title: 'Ecosystem monetization:',
            description:
              'Converting a free user into a patron is built on a sense of belonging, community access, and an exclusive backlog.',
          },
        ],
      },
      {
        title: 'Product Roadmap',
        description:
          'The GunLib product roadmap creates a predictable path for development, avoiding premature complexity and helping allocate MVP resources.',
        image: '/images/cases/gunlib-research-roadmap-a.png',
        imageAlt: 'GunLib product development roadmap',
        points: [
          {
