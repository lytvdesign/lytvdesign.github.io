        ],
      },
      {
        title: 'Lean Canvas',
        description:
          'The completed Lean Canvas defined a sustainable, low-cost business model by connecting the value proposition to the real market context.',
        image: '/images/cases/gunlib-research-lean-a.png',
        imageAlt: 'GunLib Lean Canvas business model',
        points: [
          {
            title: 'Expert content model:',
            description:
              'Engaging subject-matter authors and instructors makes it possible to systematically expand the knowledge base with verified materials while preserving high quality and data accuracy.',
          },
          {
