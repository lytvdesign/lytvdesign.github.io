const copy = content[locale];

---

<section class="gunlib-research" aria-labelledby="gunlib-research-title">
  <div class="gunlib-research__intro">
    <h2 id="gunlib-research-title">
      {copy.title.map((line) => <span>{line}</span>)}
    </h2>
    <p>{copy.description}</p>
  </div>

  <div class="gunlib-research__carousel" data-gunlib-research>
    <div
      class="gunlib-research__viewport"
      role="region"
      aria-roledescription="carousel"
      aria-label={copy.sliderLabel}
      tabindex="0"
      data-gunlib-research-viewport
    >
      <div class="gunlib-research__track" data-gunlib-research-track>
        {copy.slides.map((slide, index) => (
          <article
            class:list={[
              'gunlib-research__slide',
              {
                'gunlib-research__slide--framework': index === 1,
                'gunlib-research__slide--aarrr': index === 3,
                'gunlib-research__slide--roadmap': index === 4,
              },
            ]}
            role="group"
            aria-roledescription="slide"
            aria-label={`${index + 1} / ${copy.slides.length}`}
            aria-current={index === 0 ? 'true' : undefined}
            data-gunlib-research-slide
          >
            <div class="gunlib-research__slide-inner">
              <div class="gunlib-research__text">
                <div class="gunlib-research__analysis">
                  <h3>
                    {slide.title} <span class="gunlib-research__slide-counter">{index + 1}/{copy.slides.length}</span>
                  </h3>
                  <p>{slide.description}</p>
                </div>

                <ul class="gunlib-research__points">
                  {slide.points.map((point) => (
                    <li>
                      <span class="gunlib-research__check">
                        <img src="/images/cases/gunlib-check-circle.svg" alt="" aria-hidden="true" width="16" height="24" />
                      </span>
                      <span class="gunlib-research__point-copy">
                        <strong>{point.title}</strong>
                        <span>{point.description}</span>
                      </span>
                    </li>
                  ))}
                </ul>
              </div>

              <button
                type="button"
                class="gunlib-research__image-link"
                aria-label={`${copy.openImage}: ${slide.title}`}
                aria-haspopup="dialog"
                data-gunlib-research-image-trigger
                data-image-src={getProgressiveImagePath(slide.image, 'optimized')}
                data-image-alt={slide.imageAlt}
              >
                <img
                  src={getProgressiveImagePath(slide.image, 'optimized')}
                  data-progressive-src={getProgressiveImagePath(slide.image, 'optimized')}
                  alt={slide.imageAlt}
                  width={index === 1 ? 761 : 767}
                  height={index === 0 ? 650 : index === 1 ? 540 : index === 2 ? 771 : index === 3 ? 834 : 554}
                  loading="lazy"
                  decoding="async"
                />
                <span class="gunlib-research__zoom">
                  <img src="/images/cases/gunlib-magnifying-glass-plus.svg" alt="" aria-hidden="true" width="24" height="24" />
                </span>
              </button>
            </div>
          </article>
        ))}
      </div>
    </div>

    <div class="gunlib-research__controls" aria-label={copy.sliderLabel}>
      <button type="button" class="gunlib-research__control" data-gunlib-research-previous aria-label={copy.previous}>
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="m14.5 5-7 7 7 7" />
        </svg>
      </button>
      <span class="gunlib-research__counter" aria-live="polite" data-gunlib-research-counter>1 / {copy.slides.length}</span>
      <button type="button" class="gunlib-research__control" data-gunlib-research-next aria-label={copy.next}>
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="m9.5 5 7 7-7 7" />
        </svg>
      </button>
    </div>
  </div>

  <dialog class="gunlib-research__image-dialog" data-gunlib-research-image-dialog aria-label={copy.openImage}>
    <div class="gunlib-research__image-dialog-inner">
      <button type="button" class="gunlib-research__image-dialog-close" data-gunlib-research-image-close aria-label={locale === 'uk' ? 'Закрити зображення' : 'Close image'}>
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="m6 6 12 12M18 6 6 18" />
        </svg>
      </button>
      <img data-gunlib-research-image-dialog-image alt="" decoding="async" />
    </div>
  </dialog>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-gunlib-research]').forEach((carousel) => {
    if (carousel.dataset.initialized === 'true') return;
    carousel.dataset.initialized = 'true';

    const viewport = carousel.querySelector<HTMLElement>('[data-gunlib-research-viewport]');
    const slides = Array.from(carousel.querySelectorAll<HTMLElement>('[data-gunlib-research-slide]'));
    const counter = carousel.querySelector<HTMLElement>('[data-gunlib-research-counter]');
    const previous = carousel.querySelector<HTMLButtonElement>('[data-gunlib-research-previous]');
    const next = carousel.querySelector<HTMLButtonElement>('[data-gunlib-research-next]');
    const imageDialog = carousel.parentElement?.querySelector<HTMLDialogElement>('[data-gunlib-research-image-dialog]');
    const imageDialogInner = imageDialog?.querySelector<HTMLElement>('.gunlib-research__image-dialog-inner');
    const imageDialogImage = imageDialog?.querySelector<HTMLImageElement>('[data-gunlib-research-image-dialog-image]');
    const imageDialogClose = imageDialog?.querySelector<HTMLButtonElement>('[data-gunlib-research-image-close]');
    const imageTriggers = Array.from(carousel.querySelectorAll<HTMLButtonElement>('[data-gunlib-research-image-trigger]'));

    if (!viewport || !slides.length || !counter) return;

    let activeIndex = 0;
    let scrollFrame = 0;
    let activationScroll: { left: number; top: number } | null = null;

    const update = (index: number) => {
      activeIndex = Math.min(Math.max(index, 0), slides.length - 1);
      counter.textContent = `${activeIndex + 1} / ${slides.length}`;
      slides.forEach((slide, slideIndex) => {
        if (slideIndex === activeIndex) {
          slide.setAttribute('aria-current', 'true');
        } else {
          slide.removeAttribute('aria-current');
        }
      });
      if (previous) previous.disabled = activeIndex === 0;
      if (next) next.disabled = activeIndex === slides.length - 1;
    };

    const goTo = (index: number) => {
      const target = slides[index];
      if (!target) return;

      // Scroll only the carousel viewport. `scrollIntoView()` can also move
      // the document when the controls are near the bottom of the page.
      viewport.scrollTo({
        left: target.offsetLeft,
        behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
      });
      update(index);
    };

    const rememberPageScroll = (event: Event) => {
      if (event.type === 'keydown' && !['Enter', ' ', 'Spacebar'].includes((event as KeyboardEvent).key)) return;
      activationScroll = { left: window.scrollX, top: window.scrollY };
    };

    const restorePageScroll = () => {
      const position = activationScroll;
      activationScroll = null;
      if (!position) return;

      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          if (window.scrollX === position.left && window.scrollY === position.top) return;
          window.scrollTo({ left: position.left, top: position.top, behavior: 'auto' });
        });
      });
    };

    const bindControl = (control: HTMLButtonElement | null, direction: -1 | 1) => {
      if (!control) return;
      control.addEventListener(
        'pointerdown',
        (event) => {
          rememberPageScroll(event);
          // Keep a mouse click from moving the document to reveal the focused
          // button. Keyboard focus remains available for keyboard users.
          if ((event as PointerEvent).pointerType === 'mouse') event.preventDefault();
        },
        { capture: true },
      );
      control.addEventListener('keydown', rememberPageScroll, { capture: true });
      control.addEventListener('click', () => {
        goTo(activeIndex + direction);
        restorePageScroll();
      });
    };

    bindControl(previous, -1);
    bindControl(next, 1);

    let imageTriggerToRestore: HTMLButtonElement | null = null;

    imageTriggers.forEach((trigger) => {
      trigger.addEventListener('click', () => {
        if (!imageDialog || !imageDialogImage) return;
        imageTriggerToRestore = trigger;
        imageDialogImage.src = trigger.dataset.imageSrc ?? '';
        imageDialogImage.alt = trigger.dataset.imageAlt ?? '';
        imageDialog.showModal();
        imageDialogClose?.focus();
      });
    });

    const closeImageDialog = () => {
      if (!imageDialog?.open) return;
      imageDialog.close();
    };

    imageDialogClose?.addEventListener('click', closeImageDialog);
    imageDialogInner?.addEventListener('click', (event) => {
      if (event.target === imageDialogInner) closeImageDialog();
    });
    imageDialog?.addEventListener('close', () => {
      imageDialogImage?.removeAttribute('src');
      imageDialogImage?.removeAttribute('alt');
      imageTriggerToRestore?.focus({ preventScroll: true });
      imageTriggerToRestore = null;
    });

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        const index = visible ? slides.indexOf(visible.target as HTMLElement) : -1;
        if (index >= 0) update(index);
      },
      { root: viewport, threshold: 0.6 },
    );

    slides.forEach((slide) => observer.observe(slide));

    viewport.addEventListener(
      'scroll',
      () => {
        cancelAnimationFrame(scrollFrame);
        scrollFrame = requestAnimationFrame(() => {
          const slideWidth = viewport.clientWidth;
          if (!slideWidth) return;
          update(Math.round(viewport.scrollLeft / slideWidth));
        });
      },
      { passive: true },
    );

    update(0);
  });
</script>

<style>
  .gunlib-research,
  .gunlib-research h2,
  .gunlib-research h3,
  .gunlib-research p,
  .gunlib-research ul,
  .gunlib-research figure {
    margin: 0;
  }

  .gunlib-research {
    --research-dark: #1c1c1c;
    --research-text: #fff;
    --research-muted: rgb(255 255 255 / 88%);
    margin-inline: calc(-1 * var(--gunlib-gutter, 80px));
    width: calc(100% + (2 * var(--gunlib-gutter, 80px)));
    padding: var(--space-40) 0;
    overflow: hidden;
    background: var(--research-dark);
    color: var(--research-text);
  }

  .gunlib-research__intro {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-16);
    padding: 0 var(--space-20);
  }

  .gunlib-research__intro h2 {
    display: flex;
    flex: 0 1 469px;
    flex-direction: column;
    color: var(--research-text);
    font-size: var(--font-headline-size);
    font-weight: var(--font-headline-weight);
    line-height: var(--font-headline-line);
    letter-spacing: var(--font-headline-tracking);
  }

  .gunlib-research__intro p {
    flex: 0 1 628px;
    color: var(--research-muted);
    font-size: var(--font-body-size);
    font-weight: var(--font-body-weight);
    line-height: var(--font-body-line);
    letter-spacing: var(--font-body-tracking);
  }

  .gunlib-research__carousel {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    margin-top: var(--space-32);
  }

  .gunlib-research__viewport {
    width: 100%;
    overflow-x: auto;
