---
import type { Locale } from '../../content/site';
import { getProgressiveImagePath } from '../../lib/images';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const content = {
  uk: {
    title: ['Аналітичний етап:', 'Від дослідження до MVP'],
    description:
      'Оскільки час та ресурси на старт були обмежені, на першому етапі ми свідомо відмовилися від тривалого класичного Discovery. Замість цього ми застосували Lean MVP підхід.',
    sliderLabel: 'Аналітичні матеріали GunLib',
    previous: 'Попередній слайд',
    next: 'Наступний слайд',
    openImage: 'Відкрити зображення у високій якості',
