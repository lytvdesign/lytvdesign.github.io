---
import type { Locale } from '../../content/site';
import { homePath } from '../../lib/routes';

interface Props { locale: Locale; }

const { locale } = Astro.props;
const copy = locale === 'uk'
  ? {
      back: 'Назад',
      overview: 'Огляд проєкту',
      description: 'Trexim — це enterprise SaaS-платформа, яка централізує управління перевезеннями, автопарками, документообігом, аналітикою та взаємодією з партнерами. Я долучилася після початкового етапу дизайну, щоб перебудувати продукт, покращити користувацький досвід і підготувати платформу до MVP-розробки та подальшого масштабування.',
      heroAlt: 'Аналітична панель Trexim у макеті ноутбука',
      details: [
        ['Сфера', 'Logistics & Transportation'],
        ['Роль у проєкті', 'Product Designer'],
        ['Дата', '2026'],
        ['Платформа', 'Адаптивний веб'],
      ],
    }
  : {
      back: 'Back',
      overview: 'Project overview',
      description: 'Trexim is an enterprise SaaS platform that centralizes transportation management, fleet operations, document workflows, analytics, and partner collaboration. I joined the project after the initial design phase to restructure the product, improve user experience, and prepare the platform for MVP development and future scaling.',
      heroAlt: 'Trexim analytics dashboard shown in a laptop mockup',
      details: [
        ['Industry', 'Logistics & Transportation'],
        ['Role', 'Product Designer'],
        ['Date', '2026'],
        ['Platform', 'Responsive Web'],
      ],
    };

const backHref = homePath(locale);
---

<div class="trexim-intro">
  <section class="trexim-intro__hero" aria-labelledby="trexim-title" data-case-title-container>
    <a class="trexim-intro__back" href={backHref} aria-label={copy.back} title={copy.back} data-case-back>
      <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
        <path d="M15 8H1M1 8l6-6M1 8l6 6" />
      </svg>
    </a>
    <h1 id="trexim-title" data-case-title>Trexim</h1>
    <picture class="trexim-intro__picture">
      <img
        src="/images/trexim/cover1.preview.webp" data-progressive-src="/images/trexim/cover1.optimized.webp"
        width="3110"
        height="2332"
        alt={copy.heroAlt}
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </picture>
  </section>

  <section class="trexim-intro__overview" aria-labelledby="trexim-overview-title">
    <div class="trexim-intro__overview-copy">
      <h2 id="trexim-overview-title">{copy.overview}</h2>
      <p>{copy.description}</p>
    </div>
    <dl class="trexim-intro__details">
      {copy.details.map(([label, value], index) => (
        <div class:list={['trexim-intro__detail', `trexim-intro__detail--${index}`]}>
          <dt>{label}</dt>
          <dd>{value}</dd>
        </div>
      ))}
    </dl>
  </section>
</div>

<style>
  .trexim-intro,
  .trexim-intro h1,
  .trexim-intro h2,
  .trexim-intro p,
  .trexim-intro dl,
  .trexim-intro dd { margin: 0; }

  .trexim-intro { display: flex; width: 100%; flex-direction: column; gap: 120px; }
  .trexim-intro__hero { position: relative; width: 100%; }
  .trexim-intro h1 {
    color: var(--color-text-primary);
    font-size: var(--font-display-size);
    font-weight: var(--font-display-weight);
    line-height: var(--font-display-line);
    letter-spacing: var(--font-display-tracking);
    text-align: center;
  }
  .trexim-intro__picture { display: block; width: 100%; margin-top: 40px; overflow: hidden; border-radius: 16px; }
  .trexim-intro__picture img { display: block; width: 100%; height: auto; }
  .trexim-intro__back {
    --case-back-inline-offset: 0px;
    position: absolute;
    top: var(--case-title-center-y);
    transform: translateY(-50%);
    left: 0;
    display: grid;
    width: 64px;
    height: 40px;
    place-items: center;
    border: .5px solid var(--color-foundation-navy-300);
    border-radius: var(--radius-full);
    color: var(--color-text-primary);
  }
  .trexim-intro__back svg { width: 16px; height: 16px; }
  .trexim-intro__back path { fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.25; }
  .trexim-intro__overview { display: grid; grid-template-columns: 38.2% 49.1%; justify-content: space-between; }
  .trexim-intro__overview-copy { display: flex; flex-direction: column; gap: 40px; }
  .trexim-intro h2 { color: var(--color-text-tertiary); font-size: var(--font-headline-size); font-weight: var(--font-headline-weight); line-height: var(--font-headline-line); letter-spacing: var(--font-headline-tracking); }
  .trexim-intro__overview-copy p { color: var(--color-text-primary); font-size: var(--font-body-size); font-weight: var(--font-body-weight); line-height: var(--font-body-line); letter-spacing: var(--font-body-tracking); }
  .trexim-intro__details { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2px; padding: 11px 0 0; }
  .trexim-intro__detail { display: flex; min-height: 122px; flex-direction: column; justify-content: space-between; padding: 20px 28px; border: 1px solid #657bd4; border-radius: 16px; color: var(--color-text-primary); }
  .trexim-intro__detail dt { color: var(--color-text-tertiary); font-size: var(--font-caption-semibold-size); font-weight: var(--font-caption-semibold-weight); line-height: var(--font-caption-semibold-line); }
  .trexim-intro__detail dd { font-size: var(--font-body-semibold-size); font-weight: var(--font-body-semibold-weight); line-height: var(--font-body-semibold-line); }

  @media (min-width: 641px) and (max-width: 1024px) {
    .trexim-intro { gap: 80px; }
    .trexim-intro h1 { font-size: 64px; line-height: 82px; letter-spacing: -1.92px; }
    .trexim-intro__picture { margin-top: 48px; aspect-ratio: 1280 / 924; }
    .trexim-intro__picture img { height: 100%; object-fit: cover; object-position: center; }
    .trexim-intro__overview { display: flex; flex-direction: column; gap: 48px; }
    .trexim-intro__details { padding-top: 0; }
    .trexim-intro__detail { min-height: 122px; padding: 20px 24px; border-radius: 12px; }
  }

  @media (max-width: 640px) {
    .trexim-intro { gap: 80px; }
    .trexim-intro h1 { font-size: 40px; line-height: 40px; letter-spacing: -1.2px; }
    .trexim-intro__back { width: 40px; height: 40px; }
    .trexim-intro__picture { margin-top: 32px; aspect-ratio: 358 / 258.43; border-radius: 8px; }
    .trexim-intro__picture img { width: 100%; height: 100%; object-fit: cover; object-position: center; }
    .trexim-intro__overview { display: flex; flex-direction: column; gap: 32px; }
    .trexim-intro__overview-copy { gap: 32px; }
    .trexim-intro__details { grid-template-columns: 1fr; gap: 4px; padding-top: 0; }
    .trexim-intro__detail { min-height: 94px; padding: 12px 16px; border-radius: 10px; }
    .trexim-intro__detail--0 { order: 1; }
    .trexim-intro__detail--1 { order: 2; }
    .trexim-intro__detail--2 { order: 4; }
    .trexim-intro__detail--3 { order: 3; }
  }
</style>
