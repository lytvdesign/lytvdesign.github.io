---
import { getProgressiveImagePath } from '../../lib/images';

import Tag from './Tag.astro';

type CaseCardSize = 'compact' | 'default' | 'featured';
type CaseCardFormat = 'portrait' | 'landscape';
type CaseCardTheme = 'dark' | 'light';
type CaseCardImagePosition = 'center' | 'top' | 'bottom' | 'left' | 'right' | 'top center' | 'bottom center';

interface Props {
  title: string;
  href: string;
  image?: string;
  imageWidth?: number;
  imageHeight?: number;
  imageAlt?: string;
  tags?: string[];
  tagsLabel?: string;
  size?: CaseCardSize;
  format?: CaseCardFormat;
  theme?: CaseCardTheme;
  imagePosition?: CaseCardImagePosition;
  imageScaleX?: number;
  imageScaleY?: number;
  imageOffsetX?: number;
  imageOffsetY?: number;
  imageLoading?: 'eager' | 'lazy';
  target?: '_blank' | '_self';
  id?: string;
}

const {
  title,
  href,
  image,
  imageWidth,
  imageHeight,
  imageAlt = '',
  tags = [],
  tagsLabel,
  size = 'default',
  format = 'portrait',
  theme = 'dark',
  imagePosition = 'center',
  imageScaleX = 1,
  imageScaleY = 1,
  imageOffsetX = 0,
  imageOffsetY = 0,
  imageLoading = 'lazy',
  target = '_self',
  id,
} = Astro.props;

const isExternal = target === '_blank';
const fallbackImageDimensions = format === 'landscape' ? { width: 1600, height: 900 } : { width: 800, height: 1000 };
---

<a
  class:list={['case-card', `case-card--${size}`, `case-card--${format}`, `case-card--${theme}`]}
  id={id}
  href={href}
  target={target}
  rel={isExternal ? 'noopener noreferrer' : undefined}
  aria-label={title}
>
  <span class="case-card__media" aria-hidden={image ? undefined : 'true'}>
    {image && <img src={getProgressiveImagePath(image, 'preview')} data-progressive-src={getProgressiveImagePath(image, 'optimized')} width={imageWidth ?? fallbackImageDimensions.width} height={imageHeight ?? fallbackImageDimensions.height} alt={imageAlt} loading={imageLoading} decoding="async" style={`object-position: ${imagePosition}; --case-card-media-scale-x: ${imageScaleX}; --case-card-media-scale-y: ${imageScaleY}; --case-card-media-offset-x: ${imageOffsetX}%; --case-card-media-offset-y: ${imageOffsetY}%`} />}
  </span>
  <span class="case-card__scrim" aria-hidden="true"></span>
  <span class="case-card__content">
    {tags.length > 0 && (
      <ul class="case-card__tags" aria-label={tagsLabel}>
        {tags.map((tag) => <li><Tag label={tag} size="case-card" /></li>)}
      </ul>
    )}
    <span class="case-card__actions">
      <span class="case-card__title">{title}</span>
      <span class="case-card__arrow" aria-hidden="true"><img src="/images/icons/social-arrow.svg" alt="" /></span>
    </span>
  </span>
</a>

<style>
  .case-card {
    --case-card-bg: var(--color-surface-inverse);
    --case-card-control-bg: var(--color-accent-primary);
    --case-card-control-color: var(--color-text-inverse);
    --case-card-control-hover-bg: var(--color-surface-elevated);
    --case-card-control-hover-color: var(--color-text-primary);
    --case-card-scrim-opacity: 0;
    --case-card-scrim-hover-opacity: .3;
    position: relative;
    display: flex;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    align-items: flex-end;
    border-radius: var(--radius-2xl);
    background: var(--case-card-bg);
    color: var(--color-text-inverse);
    isolation: isolate;
  }

  .case-card--light {
    --case-card-bg: var(--color-surface-tertiary);
    --case-card-control-bg: var(--color-surface-elevated);
    --case-card-control-color: var(--color-text-primary);
    --case-card-control-hover-bg: var(--color-accent-primary);
    --case-card-control-hover-color: var(--color-text-inverse);
    --case-card-scrim-opacity: .3;
    --case-card-scrim-hover-opacity: 0;
    color: var(--color-text-primary);
  }

  /* Figma desktop variants: small 418×530; featured 850×530. */
  .case-card--compact { aspect-ratio: 223 / 260; }
  .case-card--default.case-card--portrait { aspect-ratio: 418 / 530; }
  .case-card--featured.case-card--landscape { aspect-ratio: 850 / 530; }
  .case-card--landscape:not(.case-card--featured) { aspect-ratio: 443 / 260; }
  .case-card--portrait:not(.case-card--default) { aspect-ratio: 4 / 5; }

  .case-card__media,
  .case-card__scrim {
    position: absolute;
    z-index: -1;
    inset: 0;
  }

  .case-card__media { background: var(--case-card-bg); }
  .case-card__media img {
    position: absolute;
    top: var(--case-card-media-offset-y);
    left: var(--case-card-media-offset-x);
    display: block;
    width: calc(100% * var(--case-card-media-scale-x));
    height: calc(100% * var(--case-card-media-scale-y));
    object-fit: cover;
  }
  .case-card__scrim {
    background: rgb(0 0 0 / var(--case-card-scrim-opacity));
  }

  .case-card__content {
    display: flex;
    width: 100%;
    height: 100%;
    flex-direction: column;
    justify-content: space-between;
    padding: var(--space-6);
  }
  .case-card__tags {
    display: flex;
    width: 11.25rem;
    flex-wrap: wrap;
    gap: 6px;
    padding: 0;
    margin: 0;
    list-style: none;
    opacity: 0;
  }
  .case-card__actions { display: flex; width: fit-content; max-width: 100%; align-self: flex-start; align-items: center; gap: var(--space-1); margin-top: auto; }
  .case-card__title,
  .case-card__arrow {
    display: grid;
    min-height: 5rem;
    padding: var(--space-6) var(--space-8);
    place-items: center;
    border-radius: var(--radius-l);
    background: var(--case-card-control-bg);
    color: var(--case-card-control-color);
    font-size: var(--font-subtitle-size);
    font-weight: var(--font-subtitle-weight);
    line-height: var(--font-subtitle-line);
  }
  .case-card__title { min-width: 0; flex: 0 1 auto; justify-items: start; overflow-wrap: anywhere; text-align: left; }
  .case-card__arrow { flex: 0 0 auto; width: 5.375rem; }
  .case-card__arrow img { display: block; width: 1rem; height: 1rem; filter: brightness(0) invert(1); }

  .case-card--light .case-card__tags { opacity: 1; }
  .case-card:hover .case-card__tags,
  .case-card:focus-visible .case-card__tags { opacity: 1; }
  .case-card:hover .case-card__scrim,
  .case-card:focus-visible .case-card__scrim { background: rgb(0 0 0 / var(--case-card-scrim-hover-opacity)); }
  .case-card:hover .case-card__title,
  .case-card:hover .case-card__arrow,
  .case-card:focus-visible .case-card__title,
  .case-card:focus-visible .case-card__arrow { background: var(--case-card-control-hover-bg); color: var(--case-card-control-hover-color); }
  .case-card--dark:hover .case-card__arrow img,
  .case-card--dark:focus-visible .case-card__arrow img,
  .case-card--light .case-card__arrow img { filter: none; }
  .case-card--light:hover .case-card__arrow img,
  .case-card--light:focus-visible .case-card__arrow img { filter: brightness(0) invert(1); }
  .case-card:focus-visible { outline: 2px solid var(--color-status-info); outline-offset: var(--space-1); }

  @media (min-width: 641px) and (max-width: 1024px) {
    .case-card { border-radius: var(--radius-l); }
    .case-card--light {
      --case-card-control-bg: var(--color-surface-inverse);
      --case-card-control-color: var(--color-text-inverse);
      --case-card-control-hover-bg: var(--color-surface-elevated);
      --case-card-control-hover-color: var(--color-text-primary);
      --case-card-scrim-opacity: 0;
      --case-card-scrim-hover-opacity: .2;
    }
    .case-card--light .case-card__tags { opacity: 0; }
    .case-card--light:hover .case-card__tags,
    .case-card--light:focus-visible .case-card__tags { opacity: 1; }
    .case-card--light .case-card__arrow img { filter: brightness(0) invert(1); }
    .case-card--light:hover .case-card__arrow img,
    .case-card--light:focus-visible .case-card__arrow img { filter: none; }
    .case-card__content { padding: var(--space-4); }
    .case-card__actions { width: fit-content; max-width: 100%; gap: var(--space-1); }
    .case-card__title,
    .case-card__arrow {
      min-height: 2.875rem;
      padding: var(--space-2) var(--space-4);
      border-radius: var(--radius-s);
      font-size: var(--font-body-semibold-size);
      font-weight: var(--font-body-semibold-weight);
      line-height: var(--font-body-semibold-line);
    }
    .case-card__title { flex: 0 1 auto; }
    .case-card__arrow { width: 2.75rem; }
    .case-card__arrow img { width: .75rem; height: .75rem; }
  }

  @media (max-width: 640px) {
    .case-card,
    .case-card--compact,
    .case-card--default.case-card--portrait,
    .case-card--featured.case-card--landscape,
    .case-card--landscape:not(.case-card--featured) {
      --case-card-scrim-opacity: 0;
      --case-card-scrim-hover-opacity: 0;
      aspect-ratio: 358 / 320;
      border-radius: var(--radius-2xl);
    }
    .case-card--light {
      --case-card-control-bg: var(--color-surface-inverse);
      --case-card-control-color: var(--color-text-inverse);
      --case-card-control-hover-bg: var(--color-surface-inverse);
      --case-card-control-hover-color: var(--color-text-inverse);
    }
    .case-card--light .case-card__arrow img,
    .case-card--light:hover .case-card__arrow img,
    .case-card--light:focus-visible .case-card__arrow img { filter: brightness(0) invert(1); }
    .case-card__content { padding: var(--space-6); }
    .case-card__tags { display: none; }
    .case-card__actions { width: fit-content; max-width: 100%; }
    .case-card__title,
    .case-card__arrow { min-height: 4rem; padding: var(--space-4) var(--space-6); border-radius: var(--radius-l); }
    .case-card__title { flex: 0 1 auto; max-width: 100%; font-size: 1.375rem; line-height: 2rem; }
    .case-card__arrow { width: 4rem; padding-inline: var(--space-4); }
  }

  @media (prefers-reduced-motion: reduce) {
    .case-card__scrim, .case-card__tags, .case-card__title, .case-card__arrow, .case-card__arrow img { transition: none; }
  }
</style>
