---
type TabPreviewState = 'default' | 'hover' | 'selected' | 'disabled';
type ButtonType = 'button' | 'submit' | 'reset';

interface Props {
  label: string;
  /** Renders the selected Figma state. */
  selected?: boolean;
  /** Renders a link when supplied. Disabled links become non-interactive text. */
  href?: string;
  target?: '_blank' | '_self';
  /** Renders a native button when supplied. */
  type?: ButtonType;
  disabled?: boolean;
  ariaLabel?: string;
  /** Static state preview for the UI kit; do not use for product interactions. */
  previewState?: TabPreviewState;
}

const {
  label,
  selected = false,
  href,
  target = '_self',
  type,
  disabled = false,
  ariaLabel,
  previewState,
} = Astro.props;

const resolvedState = previewState ?? (disabled ? 'disabled' : selected ? 'selected' : 'default');
const isDisabled = resolvedState === 'disabled';
const classNames = ['tab', `tab--${resolvedState}`];
const isExternal = target === '_blank';
---

{href && !isDisabled ? (
  <a
    class:list={classNames}
    href={href}
    target={target}
    rel={isExternal ? 'noopener noreferrer' : undefined}
    aria-label={ariaLabel}
    aria-current={selected ? 'page' : undefined}
  >
    {label}
  </a>
) : type && !isDisabled ? (
  <button class:list={classNames} type={type} aria-label={ariaLabel} aria-pressed={selected ? 'true' : undefined}>
    {label}
  </button>
) : (
  <span class:list={classNames} aria-label={ariaLabel} aria-disabled={isDisabled ? 'true' : undefined}>
    {label}
  </span>
)}

<style>
  .tab {
    display: inline-flex;
    min-height: 2.375rem;
    align-items: center;
    justify-content: center;
    padding: var(--space-2) var(--space-6);
    border: 0;
    border-radius: var(--radius-s);
    background: transparent;
    color: var(--color-text-secondary);
    font-family: inherit;
    font-size: 0.875rem;
    font-weight: var(--font-caption-semibold-weight);
    line-height: 1.375rem;
    letter-spacing: var(--font-caption-semibold-tracking);
    text-align: center;
    text-decoration: none;
    white-space: nowrap;
  }

  .tab--selected { background: #27292f; color: var(--color-text-inverse); }
  .tab--hover { background: #f0f1f5; }
  .tab--disabled { color: rgb(94 102 122 / 40%); }

  :is(a, button).tab:not(.tab--selected):not(.tab--disabled):hover { background: #f0f1f5; }
  :is(a, button).tab:focus-visible { outline: 2px solid var(--color-status-info); outline-offset: 2px; }

  @media (min-width: 641px) and (max-width: 1024px) {
    .tab { min-height: 2.125rem; padding: 6px var(--space-4); }
  }

  @media (max-width: 640px) {
    .tab { min-height: 2.625rem; padding: 10px var(--space-3); }
  }
</style>
