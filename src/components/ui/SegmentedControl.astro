---
export interface SegmentedControlItem {
  id: string;
  label: string;
  href: string;
}

interface Props {
  items: [SegmentedControlItem, ...SegmentedControlItem[]];
  activeId: string;
  ariaLabel?: string;
  sectionNavigation?: boolean;
}

const {
  items,
  activeId,
  ariaLabel = 'Section navigation',
  sectionNavigation = false,
} = Astro.props;
---

<nav class="segmented-control" aria-label={ariaLabel}>
  {items.map((item) => {
    const isActive = item.id === activeId;

    return (
      <a
        class:list={['segmented-control__item', { 'segmented-control__item--active': isActive }]}
        href={item.href}
        aria-current={isActive ? 'page' : undefined}
        data-section-nav={sectionNavigation ? item.id : undefined}
      >
        {item.label}
      </a>
    );
  })}
</nav>

<style>
  .segmented-control {
    display: inline-flex;
    height: 2.875rem;
    align-items: flex-start;
    padding: var(--space-1);
    border-radius: var(--radius-m);
    background: var(--color-surface-secondary);
    box-shadow: inset 0 0 0 1px var(--color-border-subtle);
  }

  .segmented-control__item {
    display: grid;
    min-width: 0;
    padding: var(--space-2) var(--space-6);
    place-items: center;
    border-radius: var(--radius-s);
    color: var(--color-text-secondary);
    font-size: var(--font-caption-semibold-size);
    font-weight: var(--font-caption-semibold-weight);
    line-height: var(--font-caption-semibold-line);
    letter-spacing: var(--font-caption-semibold-tracking);
    text-align: center;
    text-decoration: none;
    white-space: nowrap;
  }

  .segmented-control__item--active {
    background: #27292f;
    color: var(--color-text-inverse);
  }

  .segmented-control__item:not(.segmented-control__item--active):hover {
    background: #f0f1f5;
  }

  .segmented-control__item:focus-visible {
    outline: 2px solid var(--color-status-info);
    outline-offset: 2px;
  }

  @media (min-width: 641px) and (max-width: 1024px) {
    .segmented-control { height: 2.5rem; padding: 3px; }

    .segmented-control__item { padding: 6px var(--space-4); }
  }

  @media (max-width: 640px) {
    .segmented-control {
      display: flex;
      width: 100%;
      max-width: 22.375rem;
      height: 3rem;
    }

    .segmented-control__item {
      flex: 1 1 0;
      padding: 10px var(--space-3);
    }
  }
</style>
