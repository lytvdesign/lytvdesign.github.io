---
type Locale = 'uk' | 'en';

interface Props {
  activeLocale: Locale;
  ukHref: string;
  enHref: string;
  ariaLabel?: string;
  persistPreference?: boolean;
}

const {
  activeLocale,
  ukHref,
  enHref,
  ariaLabel = 'Language selector',
  persistPreference = false,
} = Astro.props;
---

<nav class="language-switcher" aria-label={ariaLabel}>
  <a
    class:list={['language-switcher__link', { 'language-switcher__link--active': activeLocale === 'uk' }]}
    href={ukHref}
    aria-current={activeLocale === 'uk' ? 'page' : undefined}
    lang="uk"
    data-language-switch={persistPreference ? true : undefined}
  >
    УКР
  </a>
  <a
    class:list={['language-switcher__link', { 'language-switcher__link--active': activeLocale === 'en' }]}
    href={enHref}
    aria-current={activeLocale === 'en' ? 'page' : undefined}
    lang="en"
    data-language-switch={persistPreference ? true : undefined}
  >
    EN
  </a>
</nav>

<script>
  document.querySelectorAll<HTMLAnchorElement>('[data-language-switch]').forEach((link) => {
    link.href += window.location.hash;
    link.addEventListener('click', () => {
      const nextLocale = link.lang === 'uk' ? 'uk' : 'en';
      localStorage.setItem('lytvynenko-locale', nextLocale);
    });
  });
</script>

<style>
  .language-switcher {
    display: inline-flex;
    width: 6.4375rem;
    height: 2.25rem;
    align-items: center;
    gap: var(--space-1);
    padding: var(--space-1);
    border-radius: var(--radius-full);
    color: var(--color-text-secondary);
    font-size: var(--font-caption-size);
    font-weight: var(--font-caption-weight);
    letter-spacing: var(--font-caption-tracking);
    line-height: var(--font-caption-line);
  }

  .language-switcher__link {
    display: grid;
    min-width: 0;
    height: 100%;
    flex: 1 1 0;
    padding: var(--space-1) var(--space-3);
    place-items: center;
    border-radius: var(--radius-full);
    color: inherit;
    text-decoration: none;
  }

  .language-switcher__link:not(.language-switcher__link--active) {
    background: rgba(255, 255, 255, .42);
    border: .5px solid rgba(255, 255, 255, .5);
    color: var(--color-text-primary);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }

  .language-switcher__link--active {
    background: var(--color-accent-primary);
    color: var(--color-text-inverse);
  }

  .language-switcher__link--active:hover { background: var(--color-accent-hover); }
  .language-switcher__link--active:active { background: var(--color-accent-pressed); }

  .language-switcher__link:focus-visible {
    outline: 2px solid var(--color-status-info);
    outline-offset: 2px;
  }
</style>
