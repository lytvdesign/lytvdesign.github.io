---
import { ui, type CaseSlug, type Locale } from '../content/site';
import { casePath } from '../lib/routes';
import CaseCard from './ui/CaseCard.astro';
import ContactCard from './ui/ContactCard.astro';
import ImageSlider from './ui/ImageSlider.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = ui[locale];
const cvHref = locale === 'en'
  ? '/documents/CV-Alina-Lytvynenko-UX-UI-Designer-EN.pdf'
  : '/documents/CV-Alina-Lytvynenko-UX-UI-Designer-UK.pdf';
const [heroLead, heroAccent, heroEnd] = locale === 'uk'
  ? ['Деталі створюють ', 'цілісність', '']
  : ['', 'Everything ', 'has its place'];
const aboutSlides = [
  { src: '/images/home/about-slide-1.png', alt: copy.aboutContent.imageAlt },
  {
    src: '/images/home/about-slide-2.png',
    alt: copy.aboutContent.imageAlt,
    crop: { desktop: { width: '100%', height: '149.64%', left: '0', top: '-28.32%' } },
  },
  {
    src: '/images/home/about-slide-3.png',
    alt: copy.aboutContent.imageAlt,
    crop: { desktop: { width: '142.39%', height: '212.96%', left: '-8.75%', top: '-66.45%' } },
  },
  {
    src: '/images/home/about-slide-4.png',
    alt: copy.aboutContent.imageAlt,
    crop: { desktop: { width: '110.37%', height: '165.3%', left: '-11.32%', top: '-57.06%' } },
  },
  { src: '/images/home/about-slide-5.png', alt: copy.aboutContent.imageAlt },
];
const portfolioCases: Array<{
  slug: CaseSlug;
  title: string;
  image: string;
  imageWidth: number;
  imageHeight: number;
  size: 'default' | 'featured';
  format: 'portrait' | 'landscape';
  imageScaleX?: number;
  imageScaleY?: number;
  imageOffsetX?: number;
  imageOffsetY?: number;
  imagePosition?: 'center' | 'top' | 'bottom' | 'left' | 'right' | 'top center' | 'bottom center';
}> = [
  {
    slug: 'gunlib',
    title: 'GunLib',
    image: '/images/cases/gunlib-hero.png',
    imageWidth: 2560,
    imageHeight: 1848,
    imagePosition: 'top',
    size: 'featured',
    format: 'landscape',
  },
  {
    slug: 'trexim',
    title: 'Trexim',
    image: '/images/home/portfolio-trexim.png',
    imageWidth: 3110,
    imageHeight: 2332,
    size: 'default',
    format: 'portrait',
    imageScaleX: 1.4102,
    imageScaleY: .834,
    imageOffsetX: -20.51,
    imageOffsetY: 2.08,
  },
  {
    slug: 'complexity',
    title: 'Complexity',
    image: '/images/home/portfolio-complexity.png',
    imageWidth: 2086,
    imageHeight: 1506,
    size: 'default',
    format: 'portrait',
    imageScaleX: 2.1336,
    imageScaleY: 1.2168,
    imageOffsetX: -56.63,
    imageOffsetY: -16.86,
  },
  {
    slug: 'enismaro',
    title: 'Enismaro',
    image: '/images/home/portfolio-enismaro.png',
    imageWidth: 1842,
    imageHeight: 1330,
    size: 'default',
    format: 'portrait',
    imageScaleX: 1.923,
    imageScaleY: 1.0968,
    imageOffsetX: -44.25,
    imageOffsetY: -9.59,
  },
  {
    slug: 'soulmatcher',
    title: 'SoulMatcher',
    image: '/images/home/portfolio-soulmatcher.png',
    imageWidth: 1900,
    imageHeight: 2380,
    size: 'default',
    format: 'portrait',
    imageScaleX: 1.9204,
    imageScaleY: 1.9002,
    imageOffsetX: -85.04,
    imageOffsetY: -1.13,
  },
];
---

<main class="home-main" data-locale={locale}>
  <section class="home-intro" data-scroll-animation="desktop" aria-labelledby="home-hero-title">
    <div class="home-hero">
      <div class="home-hero__content">
        <h1 id="home-hero-title" aria-label={copy.hero}>
          <span>{heroLead}</span><strong>{heroAccent}</strong><span>{heroEnd}</span>
        </h1>
        <a class="scroll-cue" href="#home-cards" aria-label={copy.scrollCue}>
          <img src="/images/icons/hero-more-arrow.svg" alt="" width="16" height="6" />
        </a>
      </div>
    </div>

    <div id="home-cards" class="photo-collage">
      <div class="collage-placeholders" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
      </div>

      <figure class="collage-item collage-item--location" data-scroll-motion="location" aria-hidden="true">
        <span class="collage-location__frame">
          <img class="collage-location__photo" src="/images/home/location.optimized.webp" data-progressive-src="/images/home/location.optimized.webp" alt="" width="512" height="342" loading="eager" decoding="async" />
          <figcaption class="collage-location__tag">Kharkiv, Ukraine</figcaption>
        </span>
      </figure>
      <figure class="collage-item collage-item--family" data-scroll-motion="family" aria-hidden="true">
        <span class="collage-photo-stack collage-photo-stack--family">
          <img src="/images/home/family-3.optimized.webp" data-progressive-src="/images/home/family-3.optimized.webp" alt="" width="4096" height="2731" loading="eager" decoding="async" />
        </span>
      </figure>
      <figure class="collage-item collage-item--cat" data-scroll-motion="cat" aria-hidden="true">
        <img src="/images/home/cat.optimized.webp" data-progressive-src="/images/home/cat.optimized.webp" alt="" width="512" height="342" loading="eager" decoding="async" />
      </figure>
      <figure class="collage-item collage-item--dog" data-scroll-motion="dog" aria-hidden="true">
        <span class="collage-photo-stack collage-photo-stack--dog">
          <img src="/images/home/dog-2.optimized.webp" data-progressive-src="/images/home/dog-2.optimized.webp" alt="" width="4096" height="2731" loading="eager" decoding="async" />
        </span>
      </figure>
      <a class="collage-item collage-item--projector" data-scroll-motion="projector" href="#learning" aria-label={copy.collage.projector.title}>
        <div class="collage-card collage-card--projector">
          <img class="collage-card__cover" src="/images/home/projector-card-4.optimized.webp" data-progressive-src="/images/home/projector-card-4.optimized.webp" alt="" width="1280" height="720" loading="eager" decoding="async" />
          <div class="collage-card__content">
            <p class="collage-card__eyebrow">{copy.collage.projector.eyebrow}</p>
            <div class="collage-card__author">
              <h3>{copy.collage.projector.title}</h3>
            </div>
            <p class="collage-card__description">{copy.collage.projector.description}</p>
            <span class="collage-card__more" aria-hidden="true">
              <img src="/images/icons/more-button-arrow.svg" alt="" width="16" height="6" />
            </span>
          </div>
        </div>
      </a>
      <a class="collage-item collage-item--project" data-scroll-motion="gunlib" href={casePath(locale, 'gunlib')} aria-label={copy.collage.gunlib.title}>
        <div class="collage-card collage-card--gunlib">
          <img class="collage-card__cover" src="/images/home/gunlib-card-2.optimized.webp" data-progressive-src="/images/home/gunlib-card-2.optimized.webp" alt="" width="1786" height="1242" loading="eager" decoding="async" />
          <span class="collage-card__content">
            <span class="collage-card__eyebrow">{copy.collage.gunlib.eyebrow}</span>
            <span class="collage-card__author">
              <span class="collage-card__title">{copy.collage.gunlib.title}</span>
            </span>
            <span class="collage-card__description">{copy.collage.gunlib.description}</span>
            <span class="collage-card__more" aria-hidden="true">
              <img src="/images/icons/more-button-arrow.svg" alt="" width="16" height="6" />
            </span>
          </span>
        </div>
      </a>
    </div>
  </section>

  <section id="about" class="home-section about-section" aria-labelledby="about-title">
    <h2 id="about-title">{copy.aboutContent.title}</h2>
    <div class="about-layout">
      <div class="about-copy">
        {copy.aboutContent.paragraphs.map((paragraph) => (
          <p>{paragraph.map((part) => part.strong ? <strong>{part.text}</strong> : part.text)}</p>
        ))}
      </div>
      <ImageSlider class="about-slider" slides={aboutSlides} autoplay ariaLabel={copy.aboutContent.imageLabel} />
    </div>
  </section>

  <section id="portfolio" class="home-section portfolio-section" aria-labelledby="portfolio-title">
    <h2 id="portfolio-title">{copy.portfolioContent.title}</h2>
    <div class="portfolio-grid">
      {portfolioCases.map((project) => (
        <CaseCard
          id={`portfolio-${project.slug}`}
          title={project.title}
          href={casePath(locale, project.slug)}
          image={project.image}
          imageWidth={project.imageWidth}
          imageHeight={project.imageHeight}
          tags={copy.portfolioContent.badges[project.slug]}
          tagsLabel={copy.portfolioContent.categoriesLabel}
          size={project.size}
          format={project.format}
          theme={project.theme}
          imageScaleX={project.imageScaleX}
          imageScaleY={project.imageScaleY}
          imageOffsetX={project.imageOffsetX}
          imageOffsetY={project.imageOffsetY}
          imagePosition={project.imagePosition}
        />
      ))}
    </div>
  </section>

  <section id="learning" class="learning-section" aria-labelledby="learning-title">
    <div class="learning-content">
      <div class="learning-copy">
        <h2 id="learning-title">{copy.learningContent.title}</h2>
        <p>{copy.learningContent.text}</p>
      </div>
      <div class="learning-images">
        <img class="learning-certificate" src="/images/home/learning-certificate.optimized.webp" data-progressive-src="/images/home/learning-certificate.optimized.webp" width="1920" height="1317" alt={copy.learningContent.certificateAlt} loading="lazy" />
        <img class="learning-portrait" src="/images/home/learning-portrait.optimized.webp" data-progressive-src="/images/home/learning-portrait.optimized.webp" width="891" height="1280" alt={copy.learningContent.portraitAlt} loading="lazy" />
        <img class="learning-crest" src="/images/home/learning-image-24.optimized.webp" data-progressive-src="/images/home/learning-image-24.optimized.webp" width="694" height="724" alt={copy.learningContent.crestAlt} loading="lazy" />
      </div>
    </div>
  </section>

  <section id="contact" class="home-section contact-section" aria-labelledby="contact-title">
    <div class="contact-copy">
      <h2 id="contact-title">{copy.contactContent.title}</h2>
      <div>
        {copy.contactContent.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
    <div class="contact-grid">
      <ContactCard label="LinkedIn" href="https://www.linkedin.com/in/alina-lytvynenko/" icon="linkedin" variant="card" />
      <ContactCard label="Telegram" href="https://t.me/lytv_alina" icon="telegram" variant="card" />
      <ContactCard label="lytvynenko.designer@gmail.com" href="mailto:lytvynenko.designer@gmail.com" icon="email" action="copy" variant="card" target="_self" copyToast={copy.contactContent.copyToast} />
      <ContactCard label={copy.contactContent.cv} href={cvHref} icon="document" action="external" variant="card" />
    </div>
  </section>
</main>

<script is:inline>
  (() => {
    const intro = document.querySelector('.home-intro[data-scroll-animation="desktop"]');
    if (!intro) return;

    const motionQuery = window.matchMedia('(min-width: 641px)');
    const mobileMotionQuery = window.matchMedia('(max-width: 640px)');
    const reducedMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    const collage = intro.querySelector('.photo-collage');
    const homePage = intro.closest('.home-page');
    const heroContent = intro.querySelector('.home-hero__content');
    const heroTitle = intro.querySelector('#home-hero-title');
    const heroScrollCue = intro.querySelector('.scroll-cue');
    const placeholderGrid = intro.querySelector('.collage-placeholders');
    const firstPlaceholder = intro.querySelector('.collage-placeholders span');
    const items = [...intro.querySelectorAll('[data-scroll-motion]')];
    const mobileItems = items.filter((item) => ['location', 'family', 'cat', 'dog'].includes(item.dataset.scrollMotion));
    const linkItems = items.filter((item) => item instanceof HTMLAnchorElement);
    const scrollDelay = 0;
    const mobileScrollDelay = 0;
    let scrollRange = 780;
    let animationEndScroll = null;
    const titleStopGap = 40;
    const clickableProgress = 0.75;
    const scrollCueHideProgress = 0.6;
    const scrollCueDuration = 900;
    const baseCollageWidth = 1228;
    const motions = {
      location: {
        from: { x: -80, y: -492, width: 187.458, height: 147.288, rotation: 0 },
        to: { x: 0, y: 0, width: 280, height: 220, rotation: 0 },
      },
      family: {
        from: { x: 48, y: 19.922, width: 393.751, height: 341.301, rotation: 0, innerWidth: 379.324, innerHeight: 147.201, innerRotation: -35.81 },
        borderRadius: 13,
        to: { x: 288, y: 0, width: 568, height: 220, rotation: 0, innerWidth: 568, innerHeight: 220, innerRotation: 0 },
      },
      cat: {
        from: { x: 1063, y: -490, width: 243.695, height: 413.076, rotation: 0 },
        to: { x: 864, y: 0, width: 364, height: 617, rotation: 0 },
      },
      dog: {
        from: { x: 518, y: -136, width: 187.458, height: 260.432, rotation: 0 },
        to: { x: 288, y: 228, width: 280, height: 389, rotation: 0 },
      },
      projector: {
        from: { x: -174, y: -225, width: 187.458, height: 260.432, rotation: 0, innerWidth: 187.458, innerHeight: 260.432, innerRotation: 0 },
        to: { x: 0, y: 228, width: 280, height: 389, rotation: 0, innerWidth: 280, innerHeight: 389, innerRotation: 0 },
      },
      gunlib: {
        from: { x: 819.535, y: -225, width: 230.157, height: 291.265, rotation: 0, innerWidth: 187.458, innerHeight: 262.5, innerRotation: 9.98 },
        to: { x: 576, y: 228, width: 280, height: 389, rotation: 0, innerWidth: 280, innerHeight: 389, innerRotation: 0 },
      },
    };
    const mobileMotions = {
      location: {
        from: { x: 0, y: 334.681, width: 100.558, height: 129.77, rotation: 0, innerWidth: 86.382, innerHeight: 120.01, innerRotation: -7.1 },
        to: { x: 16, y: 700.834, width: 106.638, height: 148.151, rotation: 0, innerWidth: 106.638, innerHeight: 148.151, innerRotation: 0 },
      },
      family: {
        from: { x: -119, y: 185.864, width: 184.448, height: 97.675, rotation: 0, innerWidth: 175.233, innerHeight: 67.872, innerRotation: -10.14 },
        to: { x: 16, y: 614, width: 216.323, height: 83.787, rotation: 0, innerWidth: 216.323, innerHeight: 83.787, innerRotation: 0 },
      },
      cat: {
        from: { x: 317.977, y: 312, width: 141.806, height: 207.787, rotation: 0, innerWidth: 112.297, innerHeight: 192.201, innerRotation: 9.27 },
        to: { x: 235.371, y: 614, width: 138.629, height: 234.984, rotation: 0, innerWidth: 138.629, innerHeight: 234.984, innerRotation: 0 },
      },
      dog: {
        from: { x: 156.973, y: 454, width: 98.865, height: 130.365, rotation: 0, innerWidth: 86.382, innerHeight: 121.861, innerRotation: 6.11 },
        to: { x: 125.684, y: 700.834, width: 106.638, height: 148.151, rotation: 0, innerWidth: 106.638, innerHeight: 148.151, innerRotation: 0 },
      },
    };

    let frame = 0;
    let scrollFrame = 0;
    let pointerScrollStarted = false;
    let titleDocumentBottom = 0;
    let placeholderDocumentTop = 0;
    let titleParallaxMeasured = false;
    let targetProgress = 0;
    let visualProgress = 0;
    let targetTitleOffset = 0;
    let visualTitleOffset = 0;
    let firstMotionRender = true;

      const clamp = (value, min, max) => Math.min(Math.max(value, min), max);
      const lerp = (from, to, progress) => from + (to - from) * progress;
      const easeOutCubic = (progress) => 1 - ((1 - progress) ** 3);
      const easeInOutCubic = (progress) => (
        progress < 0.5
          ? 4 * progress ** 3
          : 1 - ((-2 * progress + 2) ** 3) / 2
      );
    const getMobileScale = () => Math.max(1, Math.min((window.innerWidth - 32) / 358, 1.7));
    const getMotionRadius = (motion) => {
      const isTabletMotion = window.innerWidth >= 641 && window.innerWidth <= 1024;
      if (!isTabletMotion) return motion.borderRadius ?? 24;

      const slot = intro.querySelector('.collage-placeholders span');
      const slotRadius = slot ? Number.parseFloat(getComputedStyle(slot).borderTopLeftRadius) : Number.NaN;
      return Number.isFinite(slotRadius) ? slotRadius : (motion.borderRadius ?? 13);
    };

    const measureScrollRange = () => {
      if ((!motionQuery.matches && !mobileMotionQuery.matches) || !placeholderGrid) return;

      const gridRect = placeholderGrid.getBoundingClientRect();
      if (!gridRect.height) return;

      const activeScrollDelay = mobileMotionQuery.matches ? mobileScrollDelay : scrollDelay;
      const slotsCenterDocument = gridRect.top + window.scrollY + (gridRect.height / 2);
      const targetScrollY = slotsCenterDocument - (window.innerHeight / 2);
      animationEndScroll = Math.max(activeScrollDelay + 1, targetScrollY);
      scrollRange = animationEndScroll - activeScrollDelay;
    };

    const setLinkState = (isActive) => {
      linkItems.forEach((link) => {
        if (!link.dataset.scrollHref) {
          link.dataset.scrollHref = link.getAttribute('href') || '';
        }

        if (isActive) {
          if (link.dataset.scrollHref) link.setAttribute('href', link.dataset.scrollHref);
          link.removeAttribute('aria-disabled');
          link.removeAttribute('tabindex');
          link.classList.add('is-scroll-motion-link-active');
        } else {
          link.removeAttribute('href');
          link.setAttribute('aria-disabled', 'true');
          link.setAttribute('tabindex', '-1');
          link.classList.remove('is-scroll-motion-link-active');
        }
      });
    };

    const setScrollCueState = (progress) => {
      heroScrollCue?.classList.toggle(
        'is-scroll-cue-hidden',
        !reducedMotionQuery.matches && progress >= scrollCueHideProgress,
      );
    };

    const setMotionMode = () => {
      if (mobileMotionQuery.matches) {
        intro.classList.remove('is-scroll-motion-ready');
        intro.classList.add('is-mobile-scroll-motion-ready');
        heroContent?.style.removeProperty('transform');
        heroScrollCue?.classList.remove('is-scroll-cue-hidden');
        titleParallaxMeasured = false;
        targetProgress = 0;
        visualProgress = 0;
        firstMotionRender = true;
        animationEndScroll = null;
        items.forEach((item) => item.removeAttribute('style'));
        setLinkState(true);
        render();
        return;
      }

      intro.classList.remove('is-mobile-scroll-motion-ready');

      if (!motionQuery.matches) {
        intro.classList.remove('is-scroll-motion-ready');
        heroContent?.style.removeProperty('transform');
        heroScrollCue?.classList.remove('is-scroll-cue-hidden');
        titleParallaxMeasured = false;
        targetProgress = 0;
        visualProgress = 0;
        targetTitleOffset = 0;
        visualTitleOffset = 0;
        firstMotionRender = true;
        animationEndScroll = null;
        items.forEach((item) => {
          item.removeAttribute('style');
        });
        setLinkState(true);
        return;
      }

      intro.classList.add('is-scroll-motion-ready');
      animationEndScroll = null;
      firstMotionRender = true;
      render();
    };

    const render = () => {
      frame = 0;
      if (mobileMotionQuery.matches) {
        const mobileScale = getMobileScale();
        intro.style.setProperty('--mobile-hero-scale', `${mobileScale}`);
        homePage?.style.setProperty('--mobile-hero-scale', `${mobileScale}`);
        renderMobile();
        return;
      }
      intro.style.removeProperty('--mobile-hero-scale');
      if (!motionQuery.matches || !collage) return;

      if (animationEndScroll === null) measureScrollRange();
      const scale = collage.clientWidth / baseCollageWidth;
      const rawProgress = reducedMotionQuery.matches ? 1 : clamp((window.scrollY - scrollDelay) / Math.max(scrollRange, 1), 0, 1);
      targetProgress = rawProgress;
      visualProgress = targetProgress;

      const progress = easeOutCubic(visualProgress);
      setLinkState(reducedMotionQuery.matches || rawProgress >= clickableProgress);
      setScrollCueState(rawProgress);
      const titleIsSettling = mobileMotionQuery.matches
        ? false
        : renderTitleParallax(firstMotionRender || reducedMotionQuery.matches);
      firstMotionRender = false;

      items.forEach((item) => {
        const motion = motions[item.dataset.scrollMotion];
        if (!motion) return;

        const x = lerp(motion.from.x, motion.to.x, progress) * scale;
        const y = lerp(motion.from.y, motion.to.y, progress) * scale;
        const width = lerp(motion.from.width, motion.to.width, progress) * scale;
        const height = lerp(motion.from.height, motion.to.height, progress) * scale;
        const rotation = lerp(motion.from.rotation, motion.to.rotation, progress);

        item.style.left = `${x}px`;
        item.style.top = `${y}px`;
        item.style.width = `${width}px`;
        item.style.height = `${height}px`;
        item.style.transform = `rotate(${rotation}deg)`;

        const itemScale = motion.from.innerWidth
          ? lerp(motion.from.innerWidth / motion.to.innerWidth, 1, progress)
          : lerp(motion.from.width / motion.to.width, 1, progress);
        const motionRadius = getMotionRadius(motion);
        item.style.setProperty('--motion-item-scale', `${itemScale}`);
        item.style.setProperty('--motion-border-radius', `${motionRadius * itemScale}px`);
        item.style.borderRadius = `${motionRadius * itemScale}px`;
        item.style.borderWidth = `${(motion.borderWidth ?? 1) * itemScale}px`;

        if (motion.from.innerWidth) {
          const innerWidth = lerp(motion.from.innerWidth, motion.to.innerWidth, progress);
          const innerHeight = lerp(motion.from.innerHeight, motion.to.innerHeight, progress);
          const innerScale = lerp(motion.from.innerWidth / motion.to.innerWidth, 1, progress);

          item.style.setProperty('--motion-inner-width', `${innerWidth * scale}px`);
          item.style.setProperty('--motion-inner-height', `${innerHeight * scale}px`);
          item.style.setProperty('--motion-inner-final-width', `${motion.to.innerWidth * scale}px`);
          item.style.setProperty('--motion-inner-final-height', `${motion.to.innerHeight * scale}px`);
          item.style.setProperty('--motion-inner-scale', `${innerScale}`);
          item.style.setProperty('--motion-inner-rotation', `${lerp(motion.from.innerRotation, motion.to.innerRotation, progress)}deg`);
        }
      });

      if (!reducedMotionQuery.matches && (Math.abs(targetProgress - visualProgress) > 0.0005 || titleIsSettling)) {
        requestRender();
      }
    };

    const renderMobile = () => {
      if (!mobileMotionQuery.matches || !collage) return;

      if (animationEndScroll === null) measureScrollRange();
      const scale = getMobileScale();
      const rawProgress = reducedMotionQuery.matches ? 1 : clamp((window.scrollY - mobileScrollDelay) / Math.max(scrollRange, 1), 0, 1);
      targetProgress = rawProgress;
      visualProgress = targetProgress;

      const progress = easeOutCubic(visualProgress);
      setScrollCueState(rawProgress);
      mobileItems.forEach((item) => {
        const motion = mobileMotions[item.dataset.scrollMotion];
        if (!motion) return;

        const x = lerp(motion.from.x, motion.to.x, progress) * scale;
        const y = lerp(motion.from.y, motion.to.y, progress) * scale;
        const width = lerp(motion.from.width, motion.to.width, progress) * scale;
        const height = lerp(motion.from.height, motion.to.height, progress) * scale;
        const rotation = lerp(motion.from.rotation, motion.to.rotation, progress);
        const itemScale = lerp(motion.from.innerWidth / motion.to.innerWidth, 1, progress);
        const responsiveItemScale = scale * itemScale;

        item.style.left = `${x}px`;
        item.style.top = `${y}px`;
        item.style.width = `${width}px`;
        item.style.height = `${height}px`;
        item.style.transform = `rotate(${rotation}deg)`;
        item.style.setProperty('--motion-item-scale', `${itemScale}`);
        item.style.setProperty('--mobile-item-scale', `${responsiveItemScale}`);
        item.style.setProperty('--motion-border-radius', `${6 * responsiveItemScale}px`);
        item.style.borderRadius = `${6 * responsiveItemScale}px`;
        item.style.borderWidth = `${0.5 * responsiveItemScale}px`;

        const innerWidth = lerp(motion.from.innerWidth, motion.to.innerWidth, progress);
        const innerHeight = lerp(motion.from.innerHeight, motion.to.innerHeight, progress);
        item.style.setProperty('--motion-inner-width', `${innerWidth * scale}px`);
        item.style.setProperty('--motion-inner-height', `${innerHeight * scale}px`);
        item.style.setProperty('--motion-inner-rotation', `${lerp(motion.from.innerRotation, motion.to.innerRotation, progress)}deg`);
        item.style.setProperty('--motion-inner-radius', `${6 * responsiveItemScale}px`);
      });

      const titleIsSettling = renderTitleParallax(firstMotionRender || reducedMotionQuery.matches);
      firstMotionRender = false;
      if (!reducedMotionQuery.matches && (Math.abs(targetProgress - visualProgress) > 0.0005 || titleIsSettling)) requestRender();
    };

    const renderTitleParallax = (snapToTarget = false) => {
      if (!heroContent || !heroTitle || !firstPlaceholder) return false;

      if ((!motionQuery.matches && !mobileMotionQuery.matches) || reducedMotionQuery.matches) {
        heroContent.style.removeProperty('transform');
        heroScrollCue?.classList.remove('is-scroll-cue-hidden');
        targetTitleOffset = 0;
        visualTitleOffset = 0;
        return false;
      }

      if (!titleParallaxMeasured) {
        heroContent.style.removeProperty('transform');
        titleDocumentBottom = heroTitle.getBoundingClientRect().bottom + window.scrollY;
        placeholderDocumentTop = firstPlaceholder.getBoundingClientRect().top + window.scrollY;
        titleParallaxMeasured = true;
      }

      const scrollY = window.scrollY;
      const releaseScroll = Math.max(0, placeholderDocumentTop - titleDocumentBottom - titleStopGap);
      const mobileGridDocumentTop = mobileMotionQuery.matches
        ? placeholderGrid.getBoundingClientRect().top + scrollY
        : 0;
      const maxTitleOffset = mobileMotionQuery.matches
        ? Math.max(0, mobileGridDocumentTop - titleDocumentBottom - titleStopGap)
        : releaseScroll;
      const titleOffset = Math.max(scrollY, 0);
      targetTitleOffset = Math.min(titleOffset, maxTitleOffset);
      if (snapToTarget) {
        visualTitleOffset = targetTitleOffset;
      } else {
        visualTitleOffset += (targetTitleOffset - visualTitleOffset) * 0.18;
        if (Math.abs(targetTitleOffset - visualTitleOffset) < 0.5) visualTitleOffset = targetTitleOffset;
      }

      if (visualTitleOffset > 0) {
        heroContent.style.transform = `translate3d(0, ${visualTitleOffset}px, 0)`;
      } else {
        heroContent.style.removeProperty('transform');
      }

      return Math.abs(targetTitleOffset - visualTitleOffset) >= 0.5;
    };

    const requestRender = () => {
      if (!frame) frame = requestAnimationFrame(render);
    };

    const scrollToCards = () => {
      if (!collage) return;

      const scrollPaddingTop = Number.parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 0;
      const startY = window.scrollY;
      if (mobileMotionQuery.matches && animationEndScroll === null) measureScrollRange();
      const targetY = mobileMotionQuery.matches
        ? Math.max(mobileScrollDelay + 1, animationEndScroll ?? mobileScrollDelay + scrollRange)
        : Math.max(0, collage.getBoundingClientRect().top + startY - scrollPaddingTop);
      window.history.pushState(null, '', '#home-cards');

      cancelAnimationFrame(scrollFrame);
      document.documentElement.classList.add('is-home-scroll-controller-active');
      if (reducedMotionQuery.matches || Math.abs(targetY - startY) < 1) {
        window.scrollTo(0, targetY);
        document.documentElement.classList.remove('is-home-scroll-controller-active');
        scrollFrame = 0;
        return;
      }

      const startedAt = performance.now();
      const animateScroll = (now) => {
        const progress = clamp((now - startedAt) / scrollCueDuration, 0, 1);
        window.scrollTo(0, lerp(startY, targetY, easeInOutCubic(progress)));
        if (progress < 1) scrollFrame = requestAnimationFrame(animateScroll);
        else {
          scrollFrame = 0;
          document.documentElement.classList.remove('is-home-scroll-controller-active');
        }
      };

      scrollFrame = requestAnimationFrame(animateScroll);
    };

    const handleScrollCuePointerDown = (event) => {
      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      pointerScrollStarted = true;
      scrollToCards();
    };

    const handleScrollCueClick = (event) => {
      event.preventDefault();
      if (!pointerScrollStarted) scrollToCards();
      pointerScrollStarted = false;
    };

    heroScrollCue?.addEventListener('pointerdown', handleScrollCuePointerDown);
    heroScrollCue?.addEventListener('click', handleScrollCueClick);
    window.addEventListener('scroll', requestRender, { passive: true });
    window.addEventListener('resize', () => {
      titleParallaxMeasured = false;
      animationEndScroll = null;
      requestRender();
    });
    motionQuery.addEventListener('change', setMotionMode);
    mobileMotionQuery.addEventListener('change', setMotionMode);
    reducedMotionQuery.addEventListener('change', requestRender);
    setMotionMode();
  })();
</script>
