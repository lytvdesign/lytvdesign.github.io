---
import type { Locale } from '../content/site';
import '../../src/styles/global.css';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  showFooter?: boolean;
}

const { locale, title = 'lytvynenko.designer', description = 'UI/UX designer portfolio', showFooter = true } = Astro.props;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Ubuntu+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,600&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    {showFooter && <SiteFooter locale={locale} />}
    <script is:inline>
      (() => {
        const progressiveImages = [...document.querySelectorAll('img[data-progressive-src]')];
        const toVariantPath = (value, variant) => value
          .replace(/\.(?:preview|optimized|full)(?=\.[a-z0-9]+(?:[?#]|$))/gi, `.${variant}`);

        const getVariantSource = (image, variant) => {
          const picture = image.closest('picture');
          const baseSrc = variant === 'optimized' || variant === 'full'
            ? image.dataset.progressiveSrc
            : image.getAttribute('src');
          const sources = picture ? [...picture.querySelectorAll('source[data-progressive-srcset]')] : [];
          const matchingSource = sources.find((source) => !source.media || window.matchMedia(source.media).matches);
          const baseSrcset = matchingSource?.dataset.progressiveSrcset;

          return {
            src: baseSrc ? toVariantPath(baseSrc, variant) : null,
            srcset: baseSrcset ? toVariantPath(baseSrcset, variant) : null,
          };
        };

        const preloadVariant = (image, variant) => {
          const { src, srcset } = getVariantSource(image, variant);
          if (!src) return Promise.reject(new Error('Missing progressive image source'));

          const preloader = new Image();
          preloader.decoding = 'async';
          if (variant === 'full') preloader.fetchPriority = 'low';
          if (srcset) {
            preloader.srcset = srcset;
            const sizes = image.getAttribute('sizes');
            if (sizes) preloader.sizes = sizes;
          }

          const loaded = new Promise((resolve, reject) => {
            preloader.onload = resolve;
            preloader.onerror = reject;
          });

          preloader.src = src;

          return loaded.then(async () => {
            if (typeof preloader.decode === 'function') {
              try { await preloader.decode(); } catch {}
            }
          });
        };

        const applyVariant = (image, variant) => {
          const picture = image.closest('picture');
          const sources = picture ? [...picture.querySelectorAll('source[data-progressive-srcset]')] : [];

          sources.forEach((source) => {
            source.setAttribute('srcset', toVariantPath(source.dataset.progressiveSrcset, variant));
          });

          const { src } = getVariantSource(image, variant);
          if (src) image.src = src;
        };

        const markPreviewLoaded = (image) => {
          if (image.dataset.progressiveState === 'preview-loading') {
            image.dataset.progressiveState = 'preview-loaded';
          }
        };

        progressiveImages.forEach((image) => {
          if (image.complete) {
            image.dataset.progressiveState = image.naturalWidth > 0 ? 'preview-loaded' : 'error';
            return;
          }

          image.dataset.progressiveState = 'preview-loading';
          image.addEventListener('load', () => markPreviewLoaded(image), { once: true });
          image.addEventListener('error', () => {
            image.dataset.progressiveState = 'error';
          }, { once: true });
        });

        const scheduleFullQuality = (image) => {
          if (image.dataset.progressiveFullState) return;
          image.dataset.progressiveFullState = 'scheduled';

          const loadFullQuality = async () => {
            try {
              await preloadVariant(image, 'full');
              applyVariant(image, 'full');
              image.dataset.progressiveState = 'loaded';
              image.dataset.progressiveQualityState = 'loaded';
              image.dataset.progressiveFullState = 'loaded';
              image.removeAttribute('data-progressive-src');
            } catch {
              image.dataset.progressiveFullState = 'error';
              image.dataset.progressiveQualityState = 'optimized';
            }
          };

          if ('requestIdleCallback' in window) {
            window.requestIdleCallback(loadFullQuality, { timeout: 2500 });
          } else {
            window.setTimeout(loadFullQuality, 1500);
          }
        };

        const activate = async (image) => {
          if (image.dataset.progressiveQualityState || !image.dataset.progressiveSrc) return;

          image.dataset.progressiveQualityState = 'loading';
          try {
            await preloadVariant(image, 'optimized');
            applyVariant(image, 'optimized');
            image.dataset.progressiveState = 'optimized-loaded';
            image.dataset.progressiveQualityState = 'optimized';
            scheduleFullQuality(image);
          } catch {
            image.dataset.progressiveQualityState = 'error';
          }
        };

        const eagerImages = progressiveImages.filter((image) => image.loading !== 'lazy');
        const lazyImages = progressiveImages.filter((image) => image.loading === 'lazy');

        eagerImages.forEach((image) => {
          if (image.dataset.progressiveState === 'preview-loaded') {
            window.setTimeout(() => activate(image), 0);
          } else {
            image.addEventListener('load', () => activate(image), { once: true });
          }
        });

        if (!lazyImages.length) return;

        if (!('IntersectionObserver' in window)) {
          lazyImages.forEach(activate);
          return;
        }

        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            activate(entry.target);
            observer.unobserve(entry.target);
          });
        }, { rootMargin: '320px 0px' });

        lazyImages.forEach((image) => observer.observe(image));
      })();
    </script>
  </body>
</html>
