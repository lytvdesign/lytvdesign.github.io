---
import type { Locale } from '../content/site';
import '../../src/styles/global.css';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
}

const { locale, title = 'lytvynenko.designer', description = 'UI/UX designer portfolio' } = Astro.props;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Ubuntu+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,600&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script is:inline>
      (() => {
        const progressiveImages = [...document.querySelectorAll('img[data-progressive-src]')];
        const activate = (image) => {
          if (image.dataset.progressiveState || !image.dataset.progressiveSrc) return;

          image.dataset.progressiveState = 'loading';
          image.closest('picture')?.querySelectorAll('source[data-progressive-srcset]').forEach((source) => {
            source.setAttribute('srcset', source.dataset.progressiveSrcset);
          });

          const highQualityImage = new Image();
          highQualityImage.decoding = 'async';
          highQualityImage.onload = () => {
            image.src = image.dataset.progressiveSrc;
            image.dataset.progressiveState = 'loaded';
            image.removeAttribute('data-progressive-src');
          };
          highQualityImage.onerror = () => {
            image.dataset.progressiveState = 'error';
          };
          highQualityImage.src = image.dataset.progressiveSrc;
        };

        const eagerImages = progressiveImages.filter((image) => image.loading !== 'lazy');
        const lazyImages = progressiveImages.filter((image) => image.loading === 'lazy');

        eagerImages.forEach((image) => {
          if (image.complete) {
            window.setTimeout(() => activate(image), 0);
          } else {
            image.addEventListener('load', () => activate(image), { once: true });
          }
        });

        if (!lazyImages.length) return;

        if (!('IntersectionObserver' in window)) {
          lazyImages.forEach(activate);
          return;
        }

        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            activate(entry.target);
            observer.unobserve(entry.target);
          });
        }, { rootMargin: '320px 0px' });

        lazyImages.forEach((image) => observer.observe(image));
      })();
    </script>
  </body>
</html>
